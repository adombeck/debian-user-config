abi <abi/4.0>,

include <tunables/global>

profile debian-user-config-copilot-e2e-libvirt @{HOME}/.local/libexec/debian-user-config-e2e/copilot-e2e-libvirt flags=(attach_disconnected,mediate_deleted) {
    include <abstractions/nss-systemd>
    include <abstractions/authd>

    network,
    unix,
    signal,

    /usr/ rix,
    /usr/**/ rix,
    /usr/bin/ rix,
    /usr/sbin/ rix,
    /usr/lib/ rix,
    /usr/** mr,
    /bin/ rix,
    /bin/** mr,
    /lib/ rix,
    /lib/**/ rix,
    /lib/** mr,
    /lib64/ rix,
    /lib64/**/ rix,
    /lib64/** mr,
    /etc/ rix,
    /etc/**/ rix,
    /etc/ld.so.cache r,
    /etc/nsswitch.conf r,
    /etc/resolv.conf r,
    /etc/hosts r,
    /etc/passwd r,
    /etc/group r,
    /proc/ rix,
    /proc/self/attr/current r,
    /proc/cpuinfo r,
    /proc/meminfo r,
    /proc/stat r,
    /proc/uptime r,
    /proc/filesystems r,
    /proc/self/status r,
    /proc/sys/kernel/random/boot_id r,
    /proc/sys/kernel/ngroups_max r,
    /proc/sys/vm/overcommit_memory r,
    owner /proc/[0-9]*/ rix,
    owner /proc/[0-9]*/stat r,
    owner /proc/[0-9]*/status r,
    owner /proc/[0-9]*/attr/current r,
    owner /proc/[0-9]*/cmdline r,
    owner /proc/[0-9]*/maps r,
    /sys/ rix,
    /sys/**/ rix,
    /sys/devices/ rix,
    /sys/devices/system/ rix,
    /sys/devices/system/cpu/ rix,
    /sys/devices/system/cpu/** r,
    /sys/devices/system/node/ rix,
    /sys/devices/system/node/** r,
    /sys/devices/virtual/ rix,
    /sys/devices/virtual/dmi/ rix,
    /sys/devices/virtual/dmi/id/ rix,
    /sys/devices/virtual/dmi/id/** r,

    /dev/ rix,
    /dev/**/ rix,
    /dev/null rw,
    /dev/zero rw,
    /dev/full rw,
    /dev/random r,
    /dev/urandom r,
    /dev/kvm rw,
    /dev/vhost-vsock rw,
    /dev/ptmx rw,
    /dev/pts/ rix,
    /dev/pts/** rw,
    /dev/shm/ rw,
    /dev/shm/** rw,

    owner @{HOME}/ rix,
    owner @{HOME}/.local/ rix,
    owner @{HOME}/.local/libexec/ rix,
    owner @{HOME}/.local/libexec/debian-user-config-e2e/ rix,
    owner @{HOME}/.local/libexec/debian-user-config-e2e/copilot-e2e-libvirt rix,
    owner @{HOME}/.local/share/ rix,
    @{HOME}/.local/share/copilot-e2e-tests/ rixw,
    @{HOME}/.local/share/copilot-e2e-tests/**/ rixw,
    @{HOME}/.local/share/copilot-e2e-tests/** rwk,
    /run/ rix,
    /run/user/ rix,
    /run/user/[0-9]*/ rix,
    /run/user/[0-9]*/copilot-e2e-libvirt.*/ rixw,
    /run/user/[0-9]*/copilot-e2e-libvirt.*/**/ rixw,
    /run/user/[0-9]*/copilot-e2e-libvirt.*/** rwkl,

    /usr/sbin/libvirtd ix,
    /usr/sbin/virtlogd ix,
    /usr/sbin/virtlockd ix,
    /usr/sbin/dmidecode ix,
    /usr/bin/qemu-img ix,
    /usr/bin/qemu-system-x86_64 Px -> debian-user-config-copilot-e2e-qemu,
}

profile debian-user-config-copilot-e2e-qemu flags=(attach_disconnected,mediate_deleted) {
    network,
    unix,
    signal (send, receive) peer=debian-user-config-copilot-e2e-libvirt,
    signal (send, receive) peer=debian-user-config-copilot-e2e-qemu,
    signal (receive) peer=unconfined,

    /usr/ rix,
    /usr/**/ rix,
    /usr/bin/ rix,
    /usr/lib/ rix,
    /usr/** mr,
    /bin/ rix,
    /bin/** mr,
    /lib/ rix,
    /lib/**/ rix,
    /lib/** mr,
    /lib64/ rix,
    /lib64/**/ rix,
    /lib64/** mr,
    /etc/ rix,
    /etc/**/ rix,
    /etc/ld.so.cache r,
    /etc/resolv.conf r,
    /etc/hosts r,
    /etc/passwd r,
    /etc/group r,
    /proc/ rix,
    /proc/cpuinfo r,
    /proc/meminfo r,
    /proc/stat r,
    /proc/uptime r,
    /proc/sys/vm/overcommit_memory r,
    owner /proc/[0-9]*/ rix,
    owner /proc/[0-9]*/stat r,
    owner /proc/[0-9]*/status r,
    owner /proc/[0-9]*/maps r,
    owner /proc/[0-9]*/cmdline r,
    /sys/ rix,
    /sys/**/ rix,
    /sys/devices/ rix,
    /sys/devices/system/ rix,
    /sys/devices/system/cpu/ rix,
    /sys/devices/system/cpu/** r,
    /sys/devices/system/node/ rix,
    /sys/devices/system/node/** r,
    /sys/devices/virtual/ rix,
    /sys/devices/virtual/dmi/ rix,
    /sys/devices/virtual/dmi/id/ rix,
    /sys/devices/virtual/dmi/id/** r,

    /dev/ rix,
    /dev/**/ rix,
    /dev/null rw,
    /dev/zero rw,
    /dev/full rw,
    /dev/random r,
    /dev/urandom r,
    /dev/kvm rw,
    /dev/vhost-vsock rw,
    /dev/ptmx rw,
    /dev/pts/ rix,
    /dev/pts/** rw,
    /dev/shm/ rw,
    /dev/shm/** rw,

    owner @{HOME}/ rix,
    owner @{HOME}/.local/ rix,
    owner @{HOME}/.local/share/ rix,
    @{HOME}/.local/share/copilot-e2e-tests/ rixw,
    @{HOME}/.local/share/copilot-e2e-tests/**/ rixw,
    @{HOME}/.local/share/copilot-e2e-tests/** rwk,
    /run/ rix,
    /run/user/ rix,
    /run/user/[0-9]*/ rix,
    /run/user/[0-9]*/copilot-e2e-libvirt.*/ rixw,
    /run/user/[0-9]*/copilot-e2e-libvirt.*/**/ rixw,
    /run/user/[0-9]*/copilot-e2e-libvirt.*/** rwkl,

    /usr/bin/qemu-system-x86_64 ix,
}
