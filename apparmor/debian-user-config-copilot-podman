abi <abi/4.0>,

include <tunables/global>

profile debian-user-config-copilot-podman @{HOME}/.local/libexec/debian-user-config/copilot-podman flags=(attach_disconnected,mediate_deleted) {
    capability sys_admin,
    capability sys_chroot,
    capability setuid,
    capability setgid,
    capability setpcap,
    capability net_admin,
    capability mknod,

    userns,
    network,
    unix,
    mount,
    remount,
    umount,
    pivot_root,
    ptrace,
    signal,

    / r,
    /** rwkl,
    /** mr,
    /** ix,
}
