#!/usr/bin/env python3

import os
import stat
import sys


GUESTFISH_OPERATIONS = {
    ("stat", "/var/lib/cloud/instance/boot-finished"),
    ("cat", "/var/lib/cloud/data/result.json"),
}
REAL_VIRSH = "/usr/bin/virsh"
REAL_GUESTFISH = "/usr/bin/guestfish"


def reject(message):
    print(f"error: {message}", file=sys.stderr)
    return 125


def path_is_within(path, root):
    try:
        return os.path.commonpath((path, root)) == root
    except ValueError:
        return False


def main():
    arguments = sys.argv[1:]
    while arguments and arguments[0] in {
        "-E",
        "--preserve-env",
        "-n",
        "--non-interactive",
    }:
        arguments.pop(0)

    if arguments == ["-v"]:
        return 0
    if arguments and arguments[0] == "--":
        arguments.pop(0)
    if not arguments:
        return reject("no command was provided to sudo")

    command = arguments[0]
    if command in {"virsh", REAL_VIRSH}:
        os.execv(REAL_VIRSH, ["virsh", *arguments[1:]])

    if command not in {"guestfish", REAL_GUESTFISH}:
        return reject(
            "the rootless E2E profile only permits local virsh and read-only "
            "guestfish checks; host privilege escalation is unavailable"
        )

    if (
        len(arguments) != 7
        or arguments[1:3] != ["--ro", "-a"]
        or arguments[4] != "-i"
        or (arguments[5], arguments[6]) not in GUESTFISH_OPERATIONS
    ):
        return reject("guestfish request is not an allowlisted read-only check")

    data_root = os.environ.get("AUTHD_E2E_DATA_DIR")
    if not data_root:
        return reject("AUTHD_E2E_DATA_DIR is not set")
    data_root = os.path.realpath(data_root)
    image_path = os.path.realpath(arguments[3])
    if not path_is_within(image_path, data_root) or image_path == data_root:
        return reject("guestfish image is outside the E2E data directory")
    if not image_path.endswith(".qcow2"):
        return reject("guestfish image must be a qcow2 file")

    try:
        root_stat = os.stat(data_root)
        image_stat = os.stat(image_path, follow_symlinks=False)
    except OSError as error:
        return reject(f"could not inspect guestfish image: {error}")
    if not stat.S_ISDIR(root_stat.st_mode) or root_stat.st_uid != os.getuid():
        return reject("E2E data directory is not owned by the invoking user")
    if not stat.S_ISREG(image_stat.st_mode) or image_stat.st_uid != os.getuid():
        return reject("guestfish image is not a regular file owned by the invoking user")

    os.execv(REAL_GUESTFISH, ["guestfish", *arguments[1:]])


if __name__ == "__main__":
    raise SystemExit(main())
