#!/usr/bin/env python3

import json
import os
import pwd
import re
import selectors
import shlex
import signal
import shutil
import socket
import stat
import struct
import subprocess
import sys


GUESTFISH_HELPER = "/usr/local/libexec/debian-user-config/copilot-e2e-guestfish"
MAX_REQUEST_SIZE = 1024 * 1024
STATUS_FRAME = b"S"
STDERR_FRAME = b"E"
STDOUT_FRAME = b"O"

ALLOWED_GUESTFISH_OPERATIONS = {
    ("stat", "/var/lib/cloud/instance/boot-finished"),
    ("cat", "/var/lib/cloud/data/result.json"),
}
VM_NAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}\Z")


def receive_exact(connection, size):
    data = bytearray()
    while len(data) < size:
        chunk = connection.recv(size - len(data))
        if not chunk:
            raise ConnectionError("sudo client disconnected")
        data.extend(chunk)
    return bytes(data)


def send_frame(connection, frame_type, payload):
    connection.sendall(frame_type + struct.pack("!I", len(payload)) + payload)


def close_stdin(process):
    try:
        process.stdin.close()
    except BrokenPipeError:
        pass


def path_is_within(path, root):
    try:
        return os.path.commonpath((path, root)) == root
    except ValueError:
        return False


def validate_qemu_access_request(request, allowed_image_roots, e2e_data_root):
    if len(request) != 3 or request[0] != "qemu-access":
        raise ValueError("invalid qemu-access request")

    artifacts_dir = os.path.realpath(request[1])
    vm_name = request[2]
    if not VM_NAME_PATTERN.fullmatch(vm_name):
        raise ValueError("invalid VM name")
    if artifacts_dir != request[1] or os.path.islink(request[1]):
        raise ValueError("VM artifact directory must not be a symlink")
    if (
        e2e_data_root not in allowed_image_roots
        or os.path.dirname(artifacts_dir) != e2e_data_root
    ):
        raise ValueError("VM artifact directory is outside the E2E data root")

    caller_uid = os.getuid()
    for path in (e2e_data_root, artifacts_dir):
        try:
            path_stat = os.lstat(path)
        except FileNotFoundError as error:
            raise ValueError(f"VM artifact directory does not exist: {path}") from error
        if not stat.S_ISDIR(path_stat.st_mode) or path_stat.st_uid != caller_uid:
            raise ValueError(
                f"VM artifact directory is not owned by the invoking user: {path}"
            )

    disk_image = os.path.join(artifacts_dir, f"{vm_name}.qcow2")
    try:
        image_stat = os.lstat(disk_image)
    except FileNotFoundError as error:
        raise ValueError(f"VM disk image does not exist: {disk_image}") from error
    qemu_uid = pwd.getpwnam("libvirt-qemu").pw_uid
    if (
        not stat.S_ISREG(image_stat.st_mode)
        or image_stat.st_uid not in {caller_uid, qemu_uid}
    ):
        raise ValueError(
            f"VM disk image is not a regular file owned by the invoking user "
            f"or libvirt-qemu: {disk_image}"
        )

    return artifacts_dir, vm_name


def grant_qemu_access(artifacts_dir, vm_name):
    try:
        qemu_uid = pwd.getpwnam("libvirt-qemu").pw_uid
    except KeyError as error:
        raise RuntimeError("libvirt-qemu user was not found on the host") from error

    setfacl = shutil.which("setfacl")
    if setfacl is None:
        raise RuntimeError("setfacl is required to grant libvirt-qemu access")

    def update_acl(entry, path):
        process = subprocess.run(
            [setfacl, "-m", entry, "--", path],
            capture_output=True,
            check=False,
            text=True,
        )
        if process.returncode != 0:
            detail = process.stderr.strip() or f"exit status {process.returncode}"
            raise RuntimeError(f"could not set ACL on {path}: {detail}")

    caller_uid = os.getuid()
    qemu_gid = pwd.getpwnam("libvirt-qemu").pw_gid

    ancestors = []
    path = os.path.dirname(artifacts_dir)
    while True:
        ancestors.append(path)
        if path == "/":
            break
        path = os.path.dirname(path)

    snapshot_disk = re.compile(
        rf"{re.escape(vm_name)}\.[A-Za-z0-9_.-]+\.[0-9]{{10,}}\Z"
    )
    memory_snapshot = re.compile(
        rf"{re.escape(vm_name)}-[A-Za-z0-9_.-]+\.[0-9]{{10,}}\.mem\Z"
    )
    artifacts = []
    for entry in os.scandir(artifacts_dir):
        name = entry.name
        if name == "seed.iso":
            permissions = "r"
        elif (
            name == f"{vm_name}.qcow2"
            or snapshot_disk.fullmatch(name)
            or memory_snapshot.fullmatch(name)
        ):
            permissions = "rw"
        else:
            continue

        file_stat = entry.stat(follow_symlinks=False)
        if not stat.S_ISREG(file_stat.st_mode):
            raise RuntimeError(f"VM artifact is not a regular file: {entry.path}")
        if file_stat.st_nlink != 1:
            raise RuntimeError(f"VM artifact has multiple hard links: {entry.path}")
        if file_stat.st_uid not in {caller_uid, qemu_uid}:
            raise RuntimeError(
                f"VM artifact is not owned by the invoking user: {entry.path}"
            )
        artifacts.append((entry.path, permissions, file_stat.st_uid))

    for directory in reversed(ancestors):
        directory_stat = os.stat(directory)
        if directory_stat.st_uid == qemu_uid:
            searchable = bool(directory_stat.st_mode & stat.S_IXUSR)
        elif directory_stat.st_gid == qemu_gid:
            searchable = bool(directory_stat.st_mode & stat.S_IXGRP)
        else:
            searchable = bool(directory_stat.st_mode & stat.S_IXOTH)

        if not searchable:
            if directory_stat.st_uid != caller_uid:
                raise RuntimeError(
                    f"libvirt-qemu cannot traverse parent directory: {directory}"
                )
            update_acl(f"u:{qemu_uid}:--x", directory)

    update_acl(f"u:{qemu_uid}:wx", artifacts_dir)
    update_acl(f"d:u:{qemu_uid}:rwx", artifacts_dir)

    for path, permissions, owner_uid in artifacts:
        if owner_uid != qemu_uid:
            update_acl(f"u:{qemu_uid}:{permissions}", path)


def validate_request(request, allowed_image_roots):
    if (
        len(request) == 7
        and request[0] == "guestfish"
        and request[1:3] == ["--ro", "-a"]
        and request[4] == "-i"
        and tuple(request[5:]) in ALLOWED_GUESTFISH_OPERATIONS
    ):
        image_path = os.path.realpath(request[3])
        if (
            image_path.endswith(".qcow2")
            and os.path.isfile(image_path)
            and any(path_is_within(image_path, root) for root in allowed_image_roots)
        ):
            return

    raise ValueError(f"sudo command is not allowlisted: {shlex.join(request)}")


def run_request(connection, allowed_image_roots, e2e_data_root):
    request_size = struct.unpack("!I", receive_exact(connection, 4))[0]
    if request_size > MAX_REQUEST_SIZE:
        raise ValueError("sudo request is too large")

    request = json.loads(receive_exact(connection, request_size))
    if not isinstance(request, list) or not all(isinstance(arg, str) for arg in request):
        raise ValueError("sudo request must be a list of strings")

    if request and request[0] == "qemu-access":
        artifacts_dir, vm_name = validate_qemu_access_request(
            request, allowed_image_roots, e2e_data_root
        )
        grant_qemu_access(artifacts_dir, vm_name)
        send_frame(connection, STATUS_FRAME, struct.pack("!i", 0))
        return

    validate_request(request, allowed_image_roots)

    process = subprocess.Popen(
        [
            "sudo",
            "-n",
            GUESTFISH_HELPER,
            *allowed_image_roots,
            "--",
            request[3],
            request[5],
            request[6],
        ],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    selector = selectors.DefaultSelector()
    connection.setblocking(False)
    selector.register(connection, selectors.EVENT_READ, ("client", None))
    streams = {
        process.stdout.fileno(): (process.stdout, STDOUT_FRAME),
        process.stderr.fileno(): (process.stderr, STDERR_FRAME),
    }
    for stream, frame_type in streams.values():
        os.set_blocking(stream.fileno(), False)
        selector.register(stream, selectors.EVENT_READ, ("output", frame_type))

    stdin_open = True
    try:
        while streams:
            for key, _ in selector.select():
                kind, value = key.data
                if kind == "client":
                    data = connection.recv(65536)
                    if data and stdin_open:
                        try:
                            process.stdin.write(data)
                            process.stdin.flush()
                        except (BrokenPipeError, ValueError):
                            close_stdin(process)
                            stdin_open = False
                    elif not data and stdin_open:
                        close_stdin(process)
                        stdin_open = False
                        selector.unregister(connection)
                else:
                    data = os.read(key.fd, 65536)
                    if data:
                        send_frame(connection, value, data)
                    else:
                        selector.unregister(key.fileobj)
                        streams.pop(key.fd, None)

            if process.poll() is not None and stdin_open:
                close_stdin(process)
                stdin_open = False
                selector.unregister(connection)

        send_frame(connection, STATUS_FRAME, struct.pack("!i", process.wait()))
    finally:
        selector.close()
        if stdin_open:
            close_stdin(process)
        if process.poll() is None:
            process.terminate()
            process.wait()
        process.stdout.close()
        process.stderr.close()


def main():
    if len(sys.argv) < 4:
        print(
            f"usage: {sys.argv[0]} SOCKET E2E_DATA_ROOT "
            "ALLOWED_IMAGE_ROOT [...]",
            file=sys.stderr,
        )
        return 2

    socket_path = sys.argv[1]
    e2e_data_root = os.path.realpath(sys.argv[2])
    if not os.path.isdir(e2e_data_root):
        print(
            f"error: E2E data root is not a directory: {e2e_data_root}",
            file=sys.stderr,
        )
        return 1

    allowed_image_roots = []
    for root in sys.argv[3:]:
        if not os.path.isdir(root):
            print(f"error: allowed image root is not a directory: {root}", file=sys.stderr)
            return 1
        allowed_image_roots.append(os.path.realpath(root))
    if e2e_data_root not in allowed_image_roots:
        print("error: E2E data root is not allowlisted", file=sys.stderr)
        return 1

    if os.path.lexists(socket_path):
        if not stat_is_socket(socket_path):
            print(f"error: refusing to replace non-socket path: {socket_path}", file=sys.stderr)
            return 1
        os.unlink(socket_path)

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(socket_path)
    os.chmod(socket_path, 0o600)
    server.listen(1)

    def stop(_signum, _frame):
        raise SystemExit

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        while True:
            connection, _ = server.accept()
            with connection:
                try:
                    run_request(connection, allowed_image_roots, e2e_data_root)
                except (BrokenPipeError, ConnectionError):
                    pass
                except Exception as error:
                    try:
                        message = f"copilot e2e sudo helper: {error}\n".encode()
                        send_frame(connection, STDERR_FRAME, message)
                        send_frame(connection, STATUS_FRAME, struct.pack("!i", 125))
                    except (BrokenPipeError, ConnectionError):
                        pass
    finally:
        server.close()
        if os.path.lexists(socket_path) and stat_is_socket(socket_path):
            os.unlink(socket_path)


def stat_is_socket(path):
    return os.path.exists(path) and stat.S_ISSOCK(os.stat(path).st_mode)


if __name__ == "__main__":
    raise SystemExit(main())
