#!/usr/bin/env bash
# shellcheck disable=SC2016
#
# run GitHub Copilot CLI in a bubblewrap sandbox with filesystem access
# restricted to ~/projects (read-write) and a minimal read-only base system.
# If the cwd is outside ~/projects, its Git repository root is bind-mounted when
# available; otherwise the cwd is bind-mounted so Copilot can still work there.
# Network is left up, since Copilot CLI needs to reach
# GitHub; narrow this further with a network namespace + proxy if you want a
# domain allowlist too.
#
# Rootless Podman may be used inside the sandbox with private storage. Host
# Podman sockets and host container storage are never exposed.
#
# Libvirt is exposed through its read-only socket by default. Pass
# --allow-e2e-tests for VM lifecycle and provisioning workflows only when
# necessary. That profile joins a shared per-user libvirt session for E2E VMs,
# confined by AppArmor to a dedicated data directory and the KVM/VSOCK devices.
# It never exposes the host's system libvirt socket or system-libvirt VM files.
# Each launch gets its own VM domain and writable qcow2 overlays; provisioned
# snapshot disks are shared as read-only backing images. A launch only cleans
# up its own VM. Snapshot cloning is provided by a read-only-mounted helper in
# this repository, and its hooks are exposed through AUTHD_E2E_HOOKS_DIR. The
# shared service stops when no clients or VMs remain.
# A per-launch host broker allows only read-only guestfish checks through its
# root-owned helper. Install the scoped AppArmor and sudo policies with
# ./apparmor/install-e2e-libvirt.sh and ./sudoers/install.sh.
#
# On Ubuntu systems with bwrap-userns-restrict, install the scoped AppArmor
# transitions once with: ./apparmor/install.sh. It also enables nested
# bubblewrap only for authd worktree sessions.
#
# Authd Go tests run as the mapped account UID with a private D-Bus session.
# Private-mode fixtures are exposed as read-only copies, and package execution
# is serialized to avoid exhausting the sandbox pipe quota.
#
# Copilot runs with a private D-Bus session and GNOME Keyring. Only its
# dedicated keyring data under COPILOT_HOME is persisted; the host session bus,
# keyring, and credential-agent sockets are not exposed.
#
# A dedicated SSH agent socket, or the host's current SSH_AUTH_SOCK when no
# dedicated socket exists, may be forwarded. Private keys are never mounted.
#
# Use --shell to open the calling Bash or Zsh inside the sandbox for debugging.
#
# Installation from the repository root:
#   mv ~/.local/bin/copilot ~/.local/bin/copilot.real
#   ./scripts/install.sh
#
# The first command preserves the original Copilot executable; the installer
# then creates ~/.local/bin/copilot as a symlink to this wrapper.
#
# Usage: copilot [--allow-e2e-tests] [--shell] [copilot args...]

set -euo pipefail

if [[ "$(id -u)" -eq 0 ]]; then
    echo "error: the Copilot sandbox must not be run as root" >&2
    exit 1
fi

USER_ID="$(id -u)"
SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

ALLOW_E2E_TESTS=false
RUN_INTERACTIVE_SHELL=false
while [[ $# -gt 0 ]]; do
    case "$1" in
    --allow-e2e-tests)
        ALLOW_E2E_TESTS=true
        shift
        ;;
    --shell)
        RUN_INTERACTIVE_SHELL=true
        shift
        ;;
    *)
        break
        ;;
    esac
done

if [[ "$RUN_INTERACTIVE_SHELL" == true && $# -gt 0 ]]; then
    echo "error: --shell cannot be combined with Copilot arguments" >&2
    exit 2
fi

INTERACTIVE_SHELL_PATH=
INTERACTIVE_SHELL_KIND=
if [[ "$RUN_INTERACTIVE_SHELL" == true ]]; then
    PARENT_SHELL_PATH="$(readlink -f "/proc/$PPID/exe" 2>/dev/null || true)"
    for shell_candidate in "$PARENT_SHELL_PATH" "${SHELL:-}"; do
        [[ -n "$shell_candidate" ]] || continue
        if [[ "$shell_candidate" != /* ]]; then
            shell_candidate="$(command -v "$shell_candidate" 2>/dev/null || true)"
        fi
        [[ -n "$shell_candidate" ]] || continue

        shell_kind="${shell_candidate##*/}"
        case "$shell_kind" in
        bash|zsh)
            ;;
        *)
            continue
            ;;
        esac

        resolved_shell="$(realpath -e "$shell_candidate" 2>/dev/null || true)"
        [[ -n "$resolved_shell" && -x "$resolved_shell" ]] || continue
        case "$resolved_shell" in
        /bin/*|/usr/*|/snap/*|"$HOME"/.local/bin/*)
            INTERACTIVE_SHELL_PATH="$resolved_shell"
            INTERACTIVE_SHELL_KIND="$shell_kind"
            break
            ;;
        esac
    done

    if [[ -z "$INTERACTIVE_SHELL_PATH" ]]; then
        echo "error: --shell could not find an accessible Bash or Zsh executable" >&2
        exit 1
    fi
fi

if [[ "$ALLOW_E2E_TESTS" == true ]]; then
    cat >&2 <<'EOF'
warning: --allow-e2e-tests joins the shared AppArmor-confined per-user E2E libvirt session
warning: it does not expose the host's system libvirt socket or a host root shell
warning: a per-launch broker only allows read-only guestfish cloud-init checks
warning: E2E snapshot backing data is shared read-only; this launch uses private VM overlays
EOF
fi

PROJECTS_DIR="${HOME}/projects"
COPILOT_HOME="${COPILOT_HOME:-${HOME}/.copilot}"
HOST_CACHE_DIR="${HOME}/.cache"

if [[ ! -d "$PROJECTS_DIR" ]]; then
    echo "error: $PROJECTS_DIR does not exist" >&2
    exit 1
fi

if [[ -L "$HOST_CACHE_DIR" ]]; then
    echo "error: refusing to use symlinked host cache directory: $HOST_CACHE_DIR" >&2
    exit 1
elif [[ -e "$HOST_CACHE_DIR" && ! -d "$HOST_CACHE_DIR" ]]; then
    echo "error: host cache path is not a directory: $HOST_CACHE_DIR" >&2
    exit 1
fi
mkdir -p "$HOST_CACHE_DIR"
HOST_CACHE_DIR="$(realpath "$HOST_CACHE_DIR")"

# Use host package-manager caches as read-only lower layers. Sandbox writes go
# to persistent upper layers under COPILOT_HOME instead of touching the host
# cache directories.
validate_shared_cache_dir() {
    local cache_dir="$1"
    if [[ -L "$cache_dir" ]]; then
        echo "error: refusing to use symlinked shared cache directory: $cache_dir" >&2
        exit 1
    elif [[ -e "$cache_dir" && ! -d "$cache_dir" ]]; then
        echo "error: shared cache path is not a directory: $cache_dir" >&2
        exit 1
    fi
    mkdir -p "$cache_dir"
    realpath "$cache_dir"
}

GO_MOD_CACHE_DIR="$(validate_shared_cache_dir "$HOME/go/pkg/mod")"
CARGO_REGISTRY_CACHE_DIR="$(validate_shared_cache_dir "$HOME/.cargo/registry")"
CARGO_GIT_CACHE_DIR="$(validate_shared_cache_dir "$HOME/.cargo/git")"
RUSTUP_CACHE_DIR="$(validate_shared_cache_dir "$HOME/.rustup")"
NPM_CACHE_DIR="$(validate_shared_cache_dir "$HOME/.npm")"

# Resolve real paths so a symlinked cwd still matches under PROJECTS_DIR.
PROJECTS_DIR="$(realpath "$PROJECTS_DIR")"
CWD="$(realpath "$PWD")"
WORKDIR="$CWD"

# Mount the repository root when the cwd is inside a repository so Copilot can
# access the repository metadata and the rest of the worktree.
MOUNT_DIR="$CWD"
if REPO_ROOT="$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)"; then
    MOUNT_DIR="$(realpath "$REPO_ROOT")"
fi

# If the mount directory isn't already covered by the PROJECTS_DIR bind mount,
# bind it in separately so Copilot can still read/write it.
EXTRA_BIND_ARGS=()
case "$MOUNT_DIR" in
    "$PROJECTS_DIR"|"$PROJECTS_DIR"/*)
        ;;
    *)
        EXTRA_BIND_ARGS=(--bind "$MOUNT_DIR" "$MOUNT_DIR")
        ;;
esac

if ! command -v bwrap >/dev/null 2>&1; then
    echo "error: bubblewrap (bwrap) not found. Install with: sudo apt install bubblewrap" >&2
    exit 1
fi
BWRAP_BIN="$(command -v bwrap)"

for required_command in dbus-daemon dbus-send gnome-keyring-daemon getent; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        echo "error: $required_command not found; install the D-Bus and GNOME Keyring packages" >&2
        exit 1
    fi
done

if ! command -v copilot >/dev/null 2>&1; then
    echo "error: copilot CLI not found on PATH" >&2
    exit 1
fi

COPILOT_DIR="$(dirname "$(command -v copilot)")"
COPILOT_BIN="${COPILOT_DIR}/copilot.real"

if [[ ! -x "$COPILOT_BIN" ]]; then
    echo "error: $COPILOT_BIN not found or not executable" >&2
    exit 1
fi

if [[ "$ALLOW_E2E_TESTS" == true ]]; then
    NO_NEW_PRIVS=
    while read -r status_name status_value _; do
        if [[ "$status_name" == NoNewPrivs: ]]; then
            NO_NEW_PRIVS="$status_value"
            break
        fi
    done </proc/self/status
    if [[ "$NO_NEW_PRIVS" == 1 ]]; then
        echo "error: --allow-e2e-tests must be started outside a no_new_privileges sandbox to select the kvm group" >&2
        exit 1
    fi
    for helper in copilot-e2e-sudo copilot-e2e-sudo-helper copilot-e2e-rebase-libvirt-xml copilot-e2e-virsh copilot-e2e-libvirt; do
        if [[ ! -x "$SCRIPT_DIR/$helper" ]]; then
            echo "error: E2E helper is missing or not executable: $SCRIPT_DIR/$helper" >&2
            exit 1
        fi
    done
    if [[ -L "$SCRIPT_DIR/e2e" || ! -d "$SCRIPT_DIR/e2e" ||
        -L "$SCRIPT_DIR/e2e/copilot_e2e_session_vm.py" ||
        ! -f "$SCRIPT_DIR/e2e/copilot_e2e_session_vm.py" ||
        ! -r "$SCRIPT_DIR/e2e/copilot_e2e_session_vm.py" ||
        -L "$SCRIPT_DIR/e2e/hooks" || ! -d "$SCRIPT_DIR/e2e/hooks" ||
        -L "$SCRIPT_DIR/e2e/hooks/virsh" || ! -f "$SCRIPT_DIR/e2e/hooks/virsh" ||
        ! -x "$SCRIPT_DIR/e2e/hooks/virsh" ||
        -L "$SCRIPT_DIR/e2e/hooks/prepare-vm" || ! -f "$SCRIPT_DIR/e2e/hooks/prepare-vm" ||
        ! -x "$SCRIPT_DIR/e2e/hooks/prepare-vm" ]]; then
        echo "error: Copilot E2E VM helper or hooks are missing or unusable" >&2
        exit 1
    fi
    for helper in \
        /usr/sbin/libvirtd \
        /usr/bin/systemd-run \
        /usr/bin/flock \
        /usr/bin/virsh \
        /usr/bin/qemu-system-x86_64 \
        /usr/bin/guestfish \
        /usr/bin/socat \
        /usr/bin/xmllint
    do
        if [[ ! -x "$helper" ]]; then
            echo "error: E2E dependency is missing or not executable: $helper" >&2
            exit 1
        fi
    done
    if ! command -v newgrp >/dev/null 2>&1; then
        echo "error: newgrp is required to run QEMU with the existing kvm group" >&2
        exit 1
    fi
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "error: systemctl is required to check VSOCK journal support" >&2
        exit 1
    fi
    if [[ ! -x /usr/local/libexec/debian-user-config/copilot-e2e-guestfish ]]; then
        echo "error: host guestfish helper is missing; install it with ./sudoers/install.sh" >&2
        exit 1
    fi
    if ! /usr/bin/sudo -n -l /usr/local/libexec/debian-user-config/copilot-e2e-guestfish >/dev/null 2>&1; then
        echo "error: the scoped host guestfish sudo rule is missing; install it with ./sudoers/install.sh" >&2
        exit 1
    fi
fi

# Stage a private, read-only Podman executable at the path covered by the
# optional per-launcher AppArmor profile. The host copy is updated before
# entering bwrap; the sandbox only sees the read-only bind.
PODMAN_BIN_DIR="$HOME/.local/libexec/debian-user-config"
PODMAN_BIN="$PODMAN_BIN_DIR/copilot-podman"
PODMAN_BIND_ARGS=()
SANDBOX_PATH="$PATH"

# Expose Cargo-installed build tools such as cbindgen without exposing the
# rest of the user's home directory. Keep the directory read-only because
# tool installation belongs on the host.
CARGO_BIN_DIR="$HOME/.cargo/bin"
CARGO_BIN_BIND_ARGS=()
if [[ -L "$CARGO_BIN_DIR" ]]; then
    echo "error: refusing to use symlinked Cargo bin directory: $CARGO_BIN_DIR" >&2
    exit 1
elif [[ -e "$CARGO_BIN_DIR" && ! -d "$CARGO_BIN_DIR" ]]; then
    echo "error: Cargo bin path is not a directory: $CARGO_BIN_DIR" >&2
    exit 1
elif [[ -d "$CARGO_BIN_DIR" ]]; then
    CARGO_BIN_DIR="$(realpath "$CARGO_BIN_DIR")"
    CARGO_BIN_BIND_ARGS=(--ro-bind "$CARGO_BIN_DIR" "$CARGO_BIN_DIR")
    SANDBOX_PATH="$CARGO_BIN_DIR:$SANDBOX_PATH"
fi

if command -v podman >/dev/null 2>&1; then
    PODMAN_SOURCE="$(command -v podman)"
    if [[ "$PODMAN_SOURCE" != /* || ! -f "$PODMAN_SOURCE" || ! -x "$PODMAN_SOURCE" ]]; then
        echo "error: Podman executable is not a regular executable file: $PODMAN_SOURCE" >&2
        exit 1
    fi
    PODMAN_SOURCE="$(realpath "$PODMAN_SOURCE")"
    if [[ -L "$PODMAN_BIN_DIR" ]]; then
        echo "error: refusing to use symlinked Podman launcher directory: $PODMAN_BIN_DIR" >&2
        exit 1
    fi
    mkdir -p "$PODMAN_BIN_DIR"
    chmod 700 "$PODMAN_BIN_DIR"
    if [[ -L "$PODMAN_BIN" ]]; then
        echo "error: refusing to use symlinked Podman launcher: $PODMAN_BIN" >&2
        exit 1
    elif [[ -e "$PODMAN_BIN" && ! -f "$PODMAN_BIN" ]]; then
        echo "error: Podman launcher path is not a regular file: $PODMAN_BIN" >&2
        exit 1
    fi
    if [[ "$PODMAN_SOURCE" != "$PODMAN_BIN" ]] &&
        { [[ ! -e "$PODMAN_BIN" ]] || ! cmp -s "$PODMAN_SOURCE" "$PODMAN_BIN"; }; then
        PODMAN_TEMP="$(mktemp "$PODMAN_BIN_DIR/.copilot-podman.XXXXXX")"
        cp "$PODMAN_SOURCE" "$PODMAN_TEMP"
        chmod 755 "$PODMAN_TEMP"
        mv -f "$PODMAN_TEMP" "$PODMAN_BIN"
    fi
    PODMAN_BIN_DIR="$(realpath "$PODMAN_BIN_DIR")"
    PODMAN_BIN="$(realpath "$PODMAN_BIN")"
    PODMAN_BIND_ARGS=(--ro-bind "$PODMAN_BIN_DIR" "$PODMAN_BIN_DIR")
    SANDBOX_PATH="$PODMAN_BIN_DIR:$SANDBOX_PATH"
fi

# A snap launcher needs snapd, which is intentionally not exposed in the
# sandbox. Use the uv payload directly when uv is installed from its snap.
UV_COMMAND="$(command -v uv 2>/dev/null || true)"
if [[ "$UV_COMMAND" == /snap/bin/uv && -x /snap/astral-uv/current/bin/uv ]]; then
    SANDBOX_PATH="/snap/astral-uv/current/bin:$SANDBOX_PATH"
fi

# Build bind args for Copilot's own state, creating it first so bwrap has
# something to bind (bwrap --bind requires the source to exist).
mkdir -p "$COPILOT_HOME"
COPILOT_HOME="$(realpath "$COPILOT_HOME")"

CACHE_OVERLAY_HOME="$COPILOT_HOME/cache-overlays"
if [[ -L "$CACHE_OVERLAY_HOME" ]]; then
    echo "error: refusing to use symlinked cache overlay directory: $CACHE_OVERLAY_HOME" >&2
    exit 1
elif [[ -e "$CACHE_OVERLAY_HOME" && ! -d "$CACHE_OVERLAY_HOME" ]]; then
    echo "error: cache overlay path is not a directory: $CACHE_OVERLAY_HOME" >&2
    exit 1
fi
mkdir -p "$CACHE_OVERLAY_HOME"
chmod 700 "$CACHE_OVERLAY_HOME"

SHARED_CACHE_OVERLAY_PARENT_ARGS=(
    --dir "$HOME"
    --dir "$HOME/.cache"
    --dir "$HOME/go"
    --dir "$HOME/go/pkg"
    --dir "$HOME/.cargo"
    --dir "$HOME/.cargo/registry"
    --dir "$HOME/.cargo/git"
    --dir "$HOME/.rustup"
    --dir "$HOME/.npm"
)
SHARED_CACHE_OVERLAY_ARGS=()
add_shared_cache_overlay() {
    local name="$1"
    local lower_dir="$2"
    local destination="$3"
    local overlay_dir="$CACHE_OVERLAY_HOME/$name"
    local upper_dir="$overlay_dir/upper"
    local work_dir="$overlay_dir/work"

    if [[ -L "$overlay_dir" || -L "$upper_dir" || -L "$work_dir" ]]; then
        echo "error: refusing to use symlinked cache overlay: $overlay_dir" >&2
        exit 1
    fi
    mkdir -p "$upper_dir" "$work_dir"
    chmod 700 "$overlay_dir" "$upper_dir" "$work_dir"
    SHARED_CACHE_OVERLAY_ARGS+=(
        --overlay-src "$lower_dir"
        --overlay "$upper_dir" "$work_dir" "$destination"
    )
}

add_shared_cache_overlay "xdg-cache" "$HOST_CACHE_DIR" "$HOST_CACHE_DIR"
add_shared_cache_overlay "go-mod" "$GO_MOD_CACHE_DIR" "$GO_MOD_CACHE_DIR"
add_shared_cache_overlay "cargo-registry" "$CARGO_REGISTRY_CACHE_DIR" "$CARGO_REGISTRY_CACHE_DIR"
add_shared_cache_overlay "cargo-git" "$CARGO_GIT_CACHE_DIR" "$CARGO_GIT_CACHE_DIR"
add_shared_cache_overlay "rustup" "$RUSTUP_CACHE_DIR" "$RUSTUP_CACHE_DIR"
add_shared_cache_overlay "npm" "$NPM_CACHE_DIR" "$NPM_CACHE_DIR"

E2E_LIBVIRT_RUNTIME_DIR=
E2E_LIBVIRT_SOCKET_DIR=
E2E_LIBVIRT_CONFIG_HOME=
E2E_LIBVIRT_CONFIG_DATA_HOME=
E2E_LIBVIRT_CACHE_HOME=
E2E_LIBVIRT_DATA_HOME=
E2E_LIBVIRT_HOME=
E2E_LIBVIRT_LOG=
E2E_LIBVIRT_LAUNCHER_DIR=
E2E_LIBVIRT_LAUNCHER=
E2E_LIBVIRT_MANAGER_DIR=
E2E_LIBVIRT_MANAGER_LOCK=
E2E_LIBVIRT_MANAGER_LOCK_FD=
E2E_LIBVIRT_LEASE_DIR=
E2E_LIBVIRT_LEASE_FILE=
E2E_LIBVIRT_LEASE_FD=
E2E_LIBVIRT_SESSION_ID=
AUTHD_E2E_SESSION_DATA_HOST_DIR=
AUTHD_E2E_SESSION_DATA_CREATED=false
AUTHD_E2E_TEST_RUNS_HOST_DIR=
E2E_LIBVIRT_UNIT=
E2E_LIBVIRT_SERVICE_VERIFIED=false
E2E_LIBVIRT_KVM_GID=
E2E_SUDO_SOCKET=
E2E_SUDO_SOCKET_DIR=
E2E_SUDO_HELPER_PID=
E2E_SUDO_HELPER_LOG=
E2E_SUDO_ALLOWED_IMAGE_ROOTS=()
E2E_SUDO_CLIENT_BIND_ARGS=()
E2E_LIBVIRT_SOCKET_BIND_ARGS=()
AUTHD_E2E_SESSION_VM_HELPER_BIND_ARGS=()
E2E_SSH_PUBLIC_KEY_PARENT_ARGS=()
E2E_SSH_PUBLIC_KEY_BIND_ARGS=()

e2e_libvirt_virsh() {
    env \
        HOME="$E2E_LIBVIRT_HOME" \
        XDG_RUNTIME_DIR="$E2E_LIBVIRT_RUNTIME_DIR" \
        XDG_CONFIG_HOME="$E2E_LIBVIRT_CONFIG_HOME" \
        XDG_CACHE_HOME="$E2E_LIBVIRT_CACHE_HOME" \
        XDG_DATA_HOME="$E2E_LIBVIRT_DATA_HOME" \
        /usr/bin/virsh -c qemu:///session "$@"
}

systemd_user() {
    env XDG_RUNTIME_DIR="$HOST_XDG_RUNTIME_DIR" /usr/bin/systemctl --user "$@"
}

systemd_run_user() {
    env XDG_RUNTIME_DIR="$HOST_XDG_RUNTIME_DIR" /usr/bin/systemd-run --user "$@"
}

# Serialize service setup/teardown and keep one locked lease per active wrapper.
e2e_libvirt_lock_manager() {
    if [[ -n "$E2E_LIBVIRT_MANAGER_LOCK_FD" ]]; then
        return 0
    fi

    exec 20>>"$E2E_LIBVIRT_MANAGER_LOCK"
    E2E_LIBVIRT_MANAGER_LOCK_FD=20
    /usr/bin/flock --exclusive "$E2E_LIBVIRT_MANAGER_LOCK_FD"
}

e2e_libvirt_unlock_manager() {
    if [[ -z "$E2E_LIBVIRT_MANAGER_LOCK_FD" ]]; then
        return 0
    fi

    if ! /usr/bin/flock --unlock "$E2E_LIBVIRT_MANAGER_LOCK_FD"; then
        echo "warning: could not release the E2E libvirt manager lock" >&2
    fi
    exec 20>&-
    E2E_LIBVIRT_MANAGER_LOCK_FD=
}

e2e_libvirt_release_lease() {
    if [[ -n "$E2E_LIBVIRT_LEASE_FD" ]]; then
        if ! /usr/bin/flock --unlock "$E2E_LIBVIRT_LEASE_FD"; then
            echo "warning: could not release the E2E libvirt client lease lock" >&2
        fi
        exec 21>&-
        E2E_LIBVIRT_LEASE_FD=
    fi
    if [[ -n "$E2E_LIBVIRT_LEASE_FILE" ]]; then
        if ! rm -f -- "$E2E_LIBVIRT_LEASE_FILE"; then
            return 1
        fi
        E2E_LIBVIRT_LEASE_FILE=
    fi
    return 0
}

e2e_libvirt_has_active_clients() {
    local lease_file
    local probe_fd
    local active=false
    local -a lease_files=()

    shopt -s nullglob
    lease_files=("$E2E_LIBVIRT_LEASE_DIR"/lease.*)
    shopt -u nullglob

    for lease_file in "${lease_files[@]}"; do
        if [[ -L "$lease_file" || ! -f "$lease_file" ]]; then
            echo "warning: ignoring unsafe E2E libvirt lease entry: $lease_file" >&2
            active=true
            continue
        fi
        if ! exec {probe_fd}<>"$lease_file"; then
            echo "warning: could not inspect E2E libvirt lease: $lease_file" >&2
            active=true
            continue
        fi
        if /usr/bin/flock --nonblock --exclusive "$probe_fd"; then
            if ! rm -f -- "$lease_file"; then
                echo "warning: could not remove stale E2E libvirt lease: $lease_file" >&2
                active=true
            fi
            if ! /usr/bin/flock --unlock "$probe_fd"; then
                echo "warning: could not release stale E2E libvirt lease lock: $lease_file" >&2
                active=true
            fi
        else
            active=true
        fi
        exec {probe_fd}>&-
    done

    [[ "$active" == true ]]
}

e2e_libvirt_clear_stale_sockets() {
    local socket_path
    local -a socket_paths=(
        "$E2E_LIBVIRT_SOCKET_DIR/libvirt-sock"
        "$E2E_LIBVIRT_SOCKET_DIR/libvirt-sock-ro"
        "$E2E_LIBVIRT_SOCKET_DIR/libvirt-sock-admin"
    )

    for socket_path in "${socket_paths[@]}"; do
        if [[ -L "$socket_path" ]]; then
            echo "error: refusing to use symlinked E2E libvirt socket: $socket_path" >&2
            return 1
        fi
        if [[ ! -e "$socket_path" ]]; then
            continue
        fi
        if [[ ! -S "$socket_path" ]] ||
            [[ "$(stat -c '%u' "$socket_path")" != "$USER_ID" ]]; then
            echo "error: refusing to remove unexpected E2E libvirt socket path: $socket_path" >&2
            return 1
        fi
        if e2e_libvirt_virsh list --all >/dev/null 2>&1; then
            echo "error: an E2E libvirt socket is responding without its expected user service" >&2
            return 1
        fi
        if ! rm -f -- "$socket_path"; then
            echo "error: could not remove stale E2E libvirt socket: $socket_path" >&2
            return 1
        fi
    done
}

e2e_libvirt_assert_no_legacy_sessions() {
    local socket_path
    local -a legacy_sockets=()

    shopt -s nullglob
    legacy_sockets=("$HOST_XDG_RUNTIME_DIR"/copilot-e2e-libvirt.*/libvirt/libvirt-sock)
    shopt -u nullglob

    for socket_path in "${legacy_sockets[@]}"; do
        if [[ -S "$socket_path" ]] &&
            /usr/bin/virsh -c "qemu+unix:///session?socket=$socket_path" \
                list --all >/dev/null 2>&1; then
            echo "error: an older per-launch E2E libvirt session is still active" >&2
            echo "error: close older --allow-e2e-tests Copilot launches before retrying" >&2
            return 1
        fi
    done
    return 0
}

e2e_libvirt_validate_service() {
    local pid
    local apparmor_profile

    pid="$(systemd_user show --property=MainPID --value "$E2E_LIBVIRT_UNIT")"
    if [[ ! "$pid" =~ ^[1-9][0-9]*$ || ! -r "/proc/$pid/attr/current" ]]; then
        echo "error: could not verify the shared E2E libvirt service process" >&2
        return 1
    fi
    if ! IFS= read -r apparmor_profile <"/proc/$pid/attr/current" ||
        [[ "$apparmor_profile" != debian-user-config-copilot-e2e-libvirt* ]]; then
        echo "error: the shared E2E libvirt service is not using its AppArmor profile" >&2
        return 1
    fi
    return 0
}

e2e_libvirt_start_or_join() {
    local attempt
    local socket_path="$E2E_LIBVIRT_SOCKET_DIR/libvirt-sock"
    local ready=false
    local started_service=false
    local newgrp_command
    local -a start_args=()

    if ! e2e_libvirt_assert_no_legacy_sessions; then
        return 1
    fi
    if [[ -L "$socket_path" ]]; then
        echo "error: refusing to use a symlinked shared E2E libvirt socket" >&2
        return 1
    elif [[ -e "$socket_path" && ! -S "$socket_path" ]]; then
        echo "error: shared E2E libvirt socket path is not a socket" >&2
        return 1
    fi
    if ! systemd_user is-active --quiet "$E2E_LIBVIRT_UNIT"; then
        if ! e2e_libvirt_clear_stale_sockets; then
            return 1
        fi
        if ! "$SCRIPT_DIR/copilot-e2e-rebase-libvirt-xml" \
            "$E2E_LIBVIRT_CONFIG_DATA_HOME/libvirt/qemu" \
            "$HOST_XDG_RUNTIME_DIR" \
            "$E2E_LIBVIRT_SOCKET_DIR"; then
            echo "error: could not prepare persisted E2E libvirt domain definitions" >&2
            return 1
        fi
        if [[ -L "$E2E_LIBVIRT_CONFIG_HOME/libvirt/qemu.conf" ||
            (-e "$E2E_LIBVIRT_CONFIG_HOME/libvirt/qemu.conf" &&
                ! -f "$E2E_LIBVIRT_CONFIG_HOME/libvirt/qemu.conf") ]]; then
            echo "error: refusing to use an unexpected E2E libvirt qemu.conf path" >&2
            return 1
        fi
        if ! printf 'security_driver = "none"\n' \
            >"$E2E_LIBVIRT_CONFIG_HOME/libvirt/qemu.conf"; then
            echo "error: could not write the E2E libvirt qemu.conf file" >&2
            return 1
        fi
        if ! chmod 600 "$E2E_LIBVIRT_CONFIG_HOME/libvirt/qemu.conf"; then
            echo "error: could not secure the E2E libvirt qemu.conf file" >&2
            return 1
        fi
        if systemd_user is-failed --quiet "$E2E_LIBVIRT_UNIT"; then
            if ! systemd_user reset-failed "$E2E_LIBVIRT_UNIT"; then
                echo "error: could not reset the failed E2E libvirt service unit" >&2
                return 1
            fi
        fi
        if [[ -L "$E2E_LIBVIRT_LOG" ||
            (-e "$E2E_LIBVIRT_LOG" && ! -f "$E2E_LIBVIRT_LOG") ]]; then
            echo "error: refusing to use unexpected E2E libvirt log path: $E2E_LIBVIRT_LOG" >&2
            return 1
        fi
        if ! : >"$E2E_LIBVIRT_LOG" || ! chmod 600 "$E2E_LIBVIRT_LOG"; then
            echo "error: could not prepare the E2E libvirt service log" >&2
            return 1
        fi
        printf -v newgrp_command 'exec %q' "$E2E_LIBVIRT_LAUNCHER"
        start_args=(
            "--unit=$E2E_LIBVIRT_UNIT"
            --collect
            --quiet
            --property=Type=exec
            "--property=WorkingDirectory=$E2E_LIBVIRT_RUNTIME_DIR"
            "--property=StandardOutput=append:$E2E_LIBVIRT_LOG"
            "--property=StandardError=append:$E2E_LIBVIRT_LOG"
            "--setenv=HOME=$HOME"
            "--setenv=USER=$(id -un)"
            "--setenv=LOGNAME=$(id -un)"
            "--setenv=PATH=/usr/bin:/usr/sbin:/bin:/sbin"
            "--setenv=COPILOT_E2E_LIBVIRT_UID=$USER_ID"
            "--setenv=COPILOT_E2E_LIBVIRT_KVM_GID=$E2E_LIBVIRT_KVM_GID"
            "--setenv=COPILOT_E2E_LIBVIRT_RUNTIME_DIR=$E2E_LIBVIRT_RUNTIME_DIR"
            "--setenv=COPILOT_E2E_LIBVIRT_CONFIG_HOME=$E2E_LIBVIRT_CONFIG_HOME"
            "--setenv=COPILOT_E2E_LIBVIRT_CACHE_HOME=$E2E_LIBVIRT_CACHE_HOME"
            "--setenv=COPILOT_E2E_LIBVIRT_DATA_HOME=$E2E_LIBVIRT_DATA_HOME"
            "--setenv=COPILOT_E2E_LIBVIRT_HOME=$E2E_LIBVIRT_HOME"
            "--setenv=AUTHD_E2E_DATA_DIR=$AUTHD_E2E_DATA_HOST_DIR"
            "--setenv=XDG_RUNTIME_DIR=$HOST_XDG_RUNTIME_DIR"
            --
            /usr/bin/newgrp
            -c
            "$newgrp_command"
            kvm
        )
        if ! systemd_run_user "${start_args[@]}"; then
            echo "error: could not start the shared AppArmor-confined E2E libvirt service" >&2
            if [[ -s "$E2E_LIBVIRT_LOG" ]]; then
                cat "$E2E_LIBVIRT_LOG" >&2
            fi
            return 1
        fi
        started_service=true
    fi

    for ((attempt = 0; attempt < 100; attempt++)); do
        if [[ -S "$socket_path" ]] &&
            [[ "$(stat -c '%u' "$socket_path")" == "$USER_ID" ]] &&
            e2e_libvirt_virsh list --all >/dev/null 2>&1; then
            ready=true
            break
        fi
        if ! systemd_user is-active --quiet "$E2E_LIBVIRT_UNIT"; then
            break
        fi
        sleep 0.05
    done
    if [[ "$ready" != true ]]; then
        echo "error: could not initialize the shared AppArmor-confined E2E libvirt session" >&2
        echo "error: inspect the service with: systemctl --user status $E2E_LIBVIRT_UNIT" >&2
        if [[ -s "$E2E_LIBVIRT_LOG" ]]; then
            cat "$E2E_LIBVIRT_LOG" >&2
        fi
        if [[ "$started_service" == true ]] &&
            systemd_user is-active --quiet "$E2E_LIBVIRT_UNIT"; then
            if ! systemd_user stop "$E2E_LIBVIRT_UNIT" >/dev/null 2>&1; then
                echo "warning: could not stop the failed E2E libvirt service" >&2
            fi
        fi
        return 1
    fi

    if ! e2e_libvirt_validate_service; then
        if [[ "$started_service" == true ]] &&
            systemd_user is-active --quiet "$E2E_LIBVIRT_UNIT"; then
            if ! systemd_user stop "$E2E_LIBVIRT_UNIT" >/dev/null 2>&1; then
                echo "warning: could not stop the unverified E2E libvirt service" >&2
            fi
        fi
        return 1
    fi
    E2E_LIBVIRT_SERVICE_VERIFIED=true
}

cleanup_e2e_libvirt() {
    if [[ -n "$E2E_LIBVIRT_MANAGER_LOCK" ]] &&
        e2e_libvirt_lock_manager; then
        if ! e2e_libvirt_release_lease; then
            echo "warning: could not remove this Copilot launch's E2E libvirt lease" >&2
        fi
        local session_cleanup_safe=true
        local vm_names=
        local vm_name
        local vm_state
        local running_domains=

        if [[ "$E2E_LIBVIRT_SERVICE_VERIFIED" == true ]] &&
            [[ -S "$E2E_LIBVIRT_SOCKET_DIR/libvirt-sock" ]]; then
            if ! vm_names="$(e2e_libvirt_virsh list --all --name 2>/dev/null)"; then
                echo "warning: could not list E2E VMs during session cleanup" >&2
                session_cleanup_safe=false
            else
                while IFS= read -r vm_name; do
                    [[ "$vm_name" == *"-copilot-$E2E_LIBVIRT_SESSION_ID" ]] || continue
                    if ! vm_state="$(e2e_libvirt_virsh domstate "$vm_name" 2>/dev/null)"; then
                        echo "warning: could not inspect this session's E2E VM: $vm_name" >&2
                        session_cleanup_safe=false
                        continue
                    fi
                    case "$vm_state" in
                    running|idle|blocked|paused|shutdown|"in shutdown"|pmsuspended)
                        if ! e2e_libvirt_virsh destroy "$vm_name" >/dev/null 2>&1; then
                            echo "warning: could not stop this session's E2E VM: $vm_name" >&2
                            session_cleanup_safe=false
                            continue
                        fi
                        ;;
                    "shut off"|crashed)
                        ;;
                    *)
                        echo "warning: leaving E2E VM in unexpected state '$vm_state': $vm_name" >&2
                        session_cleanup_safe=false
                        continue
                        ;;
                    esac
                    if ! e2e_libvirt_virsh undefine "$vm_name" --snapshots-metadata >/dev/null 2>&1; then
                        echo "warning: could not undefine this session's E2E VM: $vm_name" >&2
                        session_cleanup_safe=false
                    fi
                done <<<"$vm_names"
            fi
        elif [[ "$E2E_LIBVIRT_SERVICE_VERIFIED" == true ]]; then
            echo "warning: shared E2E libvirt socket is unavailable; retaining this session's VM data" >&2
            session_cleanup_safe=false
        fi

        if [[ "$session_cleanup_safe" == true &&
            "$AUTHD_E2E_SESSION_DATA_CREATED" == true &&
            -n "$AUTHD_E2E_SESSION_DATA_HOST_DIR" &&
            "$AUTHD_E2E_SESSION_DATA_HOST_DIR" == \
                "$AUTHD_E2E_DATA_HOST_DIR"/sessions/"$E2E_LIBVIRT_SESSION_ID" &&
            -d "$AUTHD_E2E_SESSION_DATA_HOST_DIR" &&
            ! -L "$AUTHD_E2E_SESSION_DATA_HOST_DIR" ]]; then
            if ! rm -rf -- "$AUTHD_E2E_SESSION_DATA_HOST_DIR"; then
                echo "warning: could not remove this Copilot launch's E2E VM data" >&2
                session_cleanup_safe=false
            fi
        fi

        if [[ "$session_cleanup_safe" == true &&
            "$E2E_LIBVIRT_SERVICE_VERIFIED" == true ]] &&
            ! e2e_libvirt_has_active_clients &&
            systemd_user is-active --quiet "$E2E_LIBVIRT_UNIT"; then
            if [[ ! -S "$E2E_LIBVIRT_SOCKET_DIR/libvirt-sock" ]]; then
                echo "warning: shared E2E libvirt socket is unavailable; leaving service running" >&2
            elif ! running_domains="$(e2e_libvirt_virsh list --state-running --name 2>/dev/null)"; then
                echo "warning: could not list running E2E VMs; leaving libvirt running" >&2
            elif [[ -n "$running_domains" ]]; then
                echo "info: leaving shared E2E libvirt running for other active VMs" >&2
            elif ! systemd_user stop "$E2E_LIBVIRT_UNIT" >/dev/null 2>&1; then
                echo "warning: could not stop the shared E2E libvirt service" >&2
            fi
        fi
        e2e_libvirt_unlock_manager
    else
        if [[ -n "$E2E_LIBVIRT_LEASE_FILE" ]]; then
            echo "warning: could not lock shared E2E libvirt state during cleanup" >&2
        fi
    fi

    if [[ -n "$E2E_SUDO_HELPER_PID" ]]; then
        if kill -0 "$E2E_SUDO_HELPER_PID" 2>/dev/null; then
            kill "$E2E_SUDO_HELPER_PID" 2>/dev/null || true
        fi
        wait "$E2E_SUDO_HELPER_PID" 2>/dev/null || true
    fi
    if [[ -n "$E2E_SUDO_SOCKET_DIR" &&
        "$E2E_SUDO_SOCKET_DIR" == "$COPILOT_HOME"/.e2e-sudo.* ]]; then
        if [[ -S "$E2E_SUDO_SOCKET" ]]; then
            rm -f -- "$E2E_SUDO_SOCKET"
        fi
        rmdir -- "$E2E_SUDO_SOCKET_DIR" 2>/dev/null || true
    fi
    if [[ -n "$E2E_SUDO_HELPER_LOG" &&
        "$E2E_SUDO_HELPER_LOG" == "$E2E_LIBVIRT_MANAGER_DIR"/sudo-helper.* ]]; then
        rm -f -- "$E2E_SUDO_HELPER_LOG"
    fi
}

if [[ "$ALLOW_E2E_TESTS" == true ]]; then
    HOST_XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [[ -L "$HOST_XDG_RUNTIME_DIR" || ! -d "$HOST_XDG_RUNTIME_DIR" ]]; then
        echo "error: invalid host XDG_RUNTIME_DIR: $HOST_XDG_RUNTIME_DIR" >&2
        exit 1
    fi
    if [[ "$(stat -c '%u' "$HOST_XDG_RUNTIME_DIR")" != "$(id -u)" ]]; then
        echo "error: host XDG_RUNTIME_DIR is not owned by the current user" >&2
        exit 1
    fi

    if ! KVM_GROUP_ENTRY="$(getent group kvm)"; then
        echo "error: the kvm group is required for rootless E2E VMs" >&2
        exit 1
    fi
    IFS=: read -r _ _ E2E_LIBVIRT_KVM_GID _ <<<"$KVM_GROUP_ENTRY"
    if [[ ! "$E2E_LIBVIRT_KVM_GID" =~ ^[0-9]+$ ]] ||
        ! id -nG | tr ' ' '\n' | grep -Fxq kvm; then
        echo "error: the current user must belong to the kvm group for E2E VMs" >&2
        exit 1
    fi
    for device in /dev/kvm /dev/vhost-vsock /dev/vsock; do
        if [[ ! -c "$device" ]]; then
            echo "error: required E2E virtualization device is unavailable: $device" >&2
            exit 1
        fi
    done
    if [[ ! -r /dev/kvm || ! -w /dev/kvm ||
        ! -r /dev/vhost-vsock || ! -w /dev/vhost-vsock ]]; then
        echo "error: the current user cannot access /dev/kvm and /dev/vhost-vsock" >&2
        echo "error: join the kvm group, then log in again" >&2
        exit 1
    fi

    SYSTEMD_VERSION="$(systemctl --version | awk 'NR == 1 { print $2 }')"
    if [[ ! "$SYSTEMD_VERSION" =~ ^[0-9]+$ ]] ||
        ((SYSTEMD_VERSION < 256)); then
        echo "error: rootless E2E VM journaling requires systemd 256 or newer for VSOCK" >&2
        exit 1
    fi

    AUTHD_E2E_DATA_HOST_DIR="$HOME/.local/share/copilot-e2e-tests"
    for directory in "$HOME/.local" "$HOME/.local/share" "$AUTHD_E2E_DATA_HOST_DIR"; do
        if [[ -L "$directory" ]]; then
            echo "error: refusing to use a symlinked E2E data directory: $directory" >&2
            exit 1
        elif [[ -e "$directory" && ! -d "$directory" ]]; then
            echo "error: E2E data path is not a directory: $directory" >&2
            exit 1
        fi
    done
    mkdir -p "$AUTHD_E2E_DATA_HOST_DIR"
    chmod 700 "$AUTHD_E2E_DATA_HOST_DIR"
    AUTHD_E2E_DATA_HOST_DIR="$(realpath "$AUTHD_E2E_DATA_HOST_DIR")"
    if [[ "$(stat -c '%u' "$AUTHD_E2E_DATA_HOST_DIR")" != "$(id -u)" ]]; then
        echo "error: E2E data directory is not owned by the current user" >&2
        exit 1
    fi

    # Keep libvirt's domain/snapshot metadata across launches. The short path
    # leaves room for Unix socket names created below it.
    E2E_LIBVIRT_CONFIG_DATA_HOME="$AUTHD_E2E_DATA_HOST_DIR/c"
    if [[ -L "$E2E_LIBVIRT_CONFIG_DATA_HOME" ]]; then
        echo "error: refusing to use a symlinked E2E libvirt configuration directory" >&2
        exit 1
    elif [[ -e "$E2E_LIBVIRT_CONFIG_DATA_HOME" &&
        ! -d "$E2E_LIBVIRT_CONFIG_DATA_HOME" ]]; then
        echo "error: E2E libvirt configuration path is not a directory" >&2
        exit 1
    fi
    mkdir -p "$E2E_LIBVIRT_CONFIG_DATA_HOME"
    chmod 700 "$E2E_LIBVIRT_CONFIG_DATA_HOME"
    E2E_LIBVIRT_CONFIG_DATA_HOME="$(realpath "$E2E_LIBVIRT_CONFIG_DATA_HOME")"
    if [[ "$(stat -c '%u' "$E2E_LIBVIRT_CONFIG_DATA_HOME")" != "$(id -u)" ]]; then
        echo "error: E2E libvirt configuration directory is not owned by the current user" >&2
        exit 1
    fi

    E2E_LIBVIRT_RUNTIME_DIR="$HOST_XDG_RUNTIME_DIR/copilot-e2e-libvirt"
    if [[ -L "$E2E_LIBVIRT_RUNTIME_DIR" ]]; then
        echo "error: refusing to use a symlinked shared E2E libvirt runtime directory" >&2
        exit 1
    elif [[ -e "$E2E_LIBVIRT_RUNTIME_DIR" && ! -d "$E2E_LIBVIRT_RUNTIME_DIR" ]]; then
        echo "error: shared E2E libvirt runtime path is not a directory" >&2
        exit 1
    fi
    mkdir -p "$E2E_LIBVIRT_RUNTIME_DIR"
    chmod 700 "$E2E_LIBVIRT_RUNTIME_DIR"
    if [[ "$(stat -c '%u' "$E2E_LIBVIRT_RUNTIME_DIR")" != "$USER_ID" ]]; then
        echo "error: shared E2E libvirt runtime directory is not owned by the current user" >&2
        exit 1
    fi

    # Keep coordination locks outside the AppArmor-writable libvirt runtime.
    E2E_LIBVIRT_MANAGER_DIR="$HOST_XDG_RUNTIME_DIR/copilot-e2e-libvirt-manager"
    if [[ -L "$E2E_LIBVIRT_MANAGER_DIR" ]]; then
        echo "error: refusing to use a symlinked E2E libvirt manager directory" >&2
        exit 1
    elif [[ -e "$E2E_LIBVIRT_MANAGER_DIR" && ! -d "$E2E_LIBVIRT_MANAGER_DIR" ]]; then
        echo "error: E2E libvirt manager path is not a directory" >&2
        exit 1
    fi
    mkdir -p "$E2E_LIBVIRT_MANAGER_DIR"
    chmod 700 "$E2E_LIBVIRT_MANAGER_DIR"
    if [[ "$(stat -c '%u' "$E2E_LIBVIRT_MANAGER_DIR")" != "$USER_ID" ]]; then
        echo "error: E2E libvirt manager directory is not owned by the current user" >&2
        exit 1
    fi
    E2E_LIBVIRT_MANAGER_LOCK="$E2E_LIBVIRT_MANAGER_DIR/lock"
    if [[ -L "$E2E_LIBVIRT_MANAGER_LOCK" ]]; then
        echo "error: refusing to use a symlinked E2E libvirt manager lock" >&2
        exit 1
    elif [[ -e "$E2E_LIBVIRT_MANAGER_LOCK" && ! -f "$E2E_LIBVIRT_MANAGER_LOCK" ]]; then
        echo "error: E2E libvirt manager lock is not a regular file" >&2
        exit 1
    fi
    : >>"$E2E_LIBVIRT_MANAGER_LOCK"
    chmod 600 "$E2E_LIBVIRT_MANAGER_LOCK"
    if [[ "$(stat -c '%u' "$E2E_LIBVIRT_MANAGER_LOCK")" != "$USER_ID" ]]; then
        echo "error: E2E libvirt manager lock is not owned by the current user" >&2
        exit 1
    fi
    E2E_LIBVIRT_LEASE_DIR="$E2E_LIBVIRT_MANAGER_DIR/leases"
    if [[ -L "$E2E_LIBVIRT_LEASE_DIR" ]]; then
        echo "error: refusing to use a symlinked E2E libvirt lease directory" >&2
        exit 1
    elif [[ -e "$E2E_LIBVIRT_LEASE_DIR" && ! -d "$E2E_LIBVIRT_LEASE_DIR" ]]; then
        echo "error: E2E libvirt lease path is not a directory" >&2
        exit 1
    fi
    mkdir -p "$E2E_LIBVIRT_LEASE_DIR"
    chmod 700 "$E2E_LIBVIRT_LEASE_DIR"
    if [[ "$(stat -c '%u' "$E2E_LIBVIRT_LEASE_DIR")" != "$USER_ID" ]]; then
        echo "error: E2E libvirt lease directory is not owned by the current user" >&2
        exit 1
    fi

    E2E_LIBVIRT_UNIT="copilot-e2e-libvirt-${USER_ID}.service"
    E2E_LIBVIRT_LOG="$E2E_LIBVIRT_RUNTIME_DIR/launcher.log"
    e2e_libvirt_lock_manager
    E2E_LIBVIRT_LEASE_FILE="$(mktemp "$E2E_LIBVIRT_LEASE_DIR/lease.XXXXXXXX")"
    exec 21<>"$E2E_LIBVIRT_LEASE_FILE"
    E2E_LIBVIRT_LEASE_FD=21
    if ! /usr/bin/flock --nonblock --exclusive "$E2E_LIBVIRT_LEASE_FD"; then
        echo "error: could not acquire a shared E2E libvirt lease" >&2
        exit 1
    fi
    trap cleanup_e2e_libvirt EXIT

    E2E_LIBVIRT_SESSION_ID="${E2E_LIBVIRT_LEASE_FILE##*/lease.}"
    if [[ ! "$E2E_LIBVIRT_SESSION_ID" =~ ^[[:alnum:]]{8}$ ]]; then
        echo "error: could not create a valid E2E session identifier" >&2
        exit 1
    fi
    E2E_LIBVIRT_SESSION_ID="${E2E_LIBVIRT_SESSION_ID,,}"

    AUTHD_E2E_SESSION_PARENT="$AUTHD_E2E_DATA_HOST_DIR/sessions"
    if [[ -L "$AUTHD_E2E_SESSION_PARENT" ]]; then
        echo "error: refusing to use a symlinked E2E session directory" >&2
        exit 1
    elif [[ -e "$AUTHD_E2E_SESSION_PARENT" && ! -d "$AUTHD_E2E_SESSION_PARENT" ]]; then
        echo "error: E2E session path is not a directory" >&2
        exit 1
    fi
    mkdir -p "$AUTHD_E2E_SESSION_PARENT"
    chmod 700 "$AUTHD_E2E_SESSION_PARENT"
    if [[ "$(stat -c '%u' "$AUTHD_E2E_SESSION_PARENT")" != "$USER_ID" ]]; then
        echo "error: E2E session directory is not owned by the current user" >&2
        exit 1
    fi
    AUTHD_E2E_SESSION_DATA_HOST_DIR="$AUTHD_E2E_SESSION_PARENT/$E2E_LIBVIRT_SESSION_ID"
    if [[ -L "$AUTHD_E2E_SESSION_DATA_HOST_DIR" ||
        -e "$AUTHD_E2E_SESSION_DATA_HOST_DIR" ]]; then
        echo "error: E2E session data path already exists: $AUTHD_E2E_SESSION_DATA_HOST_DIR" >&2
        exit 1
    fi
    mkdir -m 700 "$AUTHD_E2E_SESSION_DATA_HOST_DIR"
    AUTHD_E2E_SESSION_DATA_CREATED=true

    AUTHD_E2E_TEST_RUNS_PARENT="/run/user/$USER_ID/authd-e2e-test-runs"
    if [[ -L "$AUTHD_E2E_TEST_RUNS_PARENT" || ! -d "$AUTHD_E2E_TEST_RUNS_PARENT" ]]; then
        echo "error: authd E2E test runs directory is missing or invalid: $AUTHD_E2E_TEST_RUNS_PARENT" >&2
        exit 1
    fi
    if [[ "$(stat -c '%u' "$AUTHD_E2E_TEST_RUNS_PARENT")" != "$USER_ID" ]]; then
        echo "error: authd E2E test runs directory is not owned by the current user" >&2
        exit 1
    fi
    AUTHD_E2E_TEST_RUNS_HOST_DIR="$AUTHD_E2E_TEST_RUNS_PARENT/copilot-$E2E_LIBVIRT_SESSION_ID"
    if [[ -L "$AUTHD_E2E_TEST_RUNS_HOST_DIR" ||
        -e "$AUTHD_E2E_TEST_RUNS_HOST_DIR" ]]; then
        echo "error: E2E session test runs path already exists: $AUTHD_E2E_TEST_RUNS_HOST_DIR" >&2
        exit 1
    fi
    mkdir -m 700 "$AUTHD_E2E_TEST_RUNS_HOST_DIR"

    E2E_LIBVIRT_SOCKET_DIR="$E2E_LIBVIRT_RUNTIME_DIR/libvirt"
    E2E_LIBVIRT_CONFIG_HOME="$E2E_LIBVIRT_RUNTIME_DIR/config"
    if [[ -L "$E2E_LIBVIRT_CONFIG_HOME" ]]; then
        if [[ "$(realpath "$E2E_LIBVIRT_CONFIG_HOME")" != "$E2E_LIBVIRT_CONFIG_DATA_HOME" ]]; then
            echo "error: shared E2E libvirt configuration symlink has an unexpected target" >&2
            exit 1
        fi
    elif [[ -e "$E2E_LIBVIRT_CONFIG_HOME" ]]; then
        echo "error: shared E2E libvirt configuration path is not a symlink" >&2
        exit 1
    else
        ln -s "$E2E_LIBVIRT_CONFIG_DATA_HOME" "$E2E_LIBVIRT_CONFIG_HOME"
    fi
    E2E_LIBVIRT_CACHE_HOME="$E2E_LIBVIRT_RUNTIME_DIR/cache"
    E2E_LIBVIRT_DATA_HOME="$E2E_LIBVIRT_RUNTIME_DIR/data"
    E2E_LIBVIRT_HOME="$E2E_LIBVIRT_RUNTIME_DIR/home"
    E2E_LIBVIRT_PRIVATE_DIRS=(
        "$E2E_LIBVIRT_SOCKET_DIR"
        "$E2E_LIBVIRT_CONFIG_HOME"
        "$E2E_LIBVIRT_CONFIG_HOME/libvirt"
        "$E2E_LIBVIRT_CONFIG_HOME/libvirt/qemu"
        "$E2E_LIBVIRT_CACHE_HOME"
        "$E2E_LIBVIRT_CACHE_HOME/libvirt"
        "$E2E_LIBVIRT_CACHE_HOME/libvirt/qemu"
        "$E2E_LIBVIRT_CACHE_HOME/libvirt/qemu/log"
        "$E2E_LIBVIRT_DATA_HOME"
        "$E2E_LIBVIRT_DATA_HOME/libvirt"
        "$E2E_LIBVIRT_DATA_HOME/libvirt/qemu"
        "$E2E_LIBVIRT_HOME"
        "$E2E_LIBVIRT_SOCKET_DIR/common"
        "$E2E_LIBVIRT_SOCKET_DIR/interface/run"
        "$E2E_LIBVIRT_SOCKET_DIR/network/lib"
        "$E2E_LIBVIRT_SOCKET_DIR/network/run"
        "$E2E_LIBVIRT_SOCKET_DIR/nodedev/run"
        "$E2E_LIBVIRT_SOCKET_DIR/qemu/run"
        "$E2E_LIBVIRT_SOCKET_DIR/secrets/run"
        "$E2E_LIBVIRT_SOCKET_DIR/storage/run"
        "$E2E_LIBVIRT_HOME/tmp"
    )
    for directory in "${E2E_LIBVIRT_PRIVATE_DIRS[@]}"; do
        if [[ "$directory" == "$E2E_LIBVIRT_CONFIG_HOME" ]]; then
            continue
        fi
        if [[ -L "$directory" ]]; then
            echo "error: refusing to use symlinked shared E2E libvirt path: $directory" >&2
            exit 1
        elif [[ -e "$directory" && ! -d "$directory" ]]; then
            echo "error: shared E2E libvirt path is not a directory: $directory" >&2
            exit 1
        fi
    done
    for directory in \
        "$E2E_LIBVIRT_CONFIG_DATA_HOME/libvirt" \
        "$E2E_LIBVIRT_CONFIG_DATA_HOME/libvirt/qemu"
    do
        if [[ -L "$directory" ]]; then
            echo "error: refusing to use symlinked E2E libvirt configuration path: $directory" >&2
            exit 1
        elif [[ -e "$directory" && ! -d "$directory" ]]; then
            echo "error: E2E libvirt configuration path is not a directory: $directory" >&2
            exit 1
        fi
    done
    mkdir -p "${E2E_LIBVIRT_PRIVATE_DIRS[@]}"
    chmod 700 "${E2E_LIBVIRT_PRIVATE_DIRS[@]}"

    E2E_LIBVIRT_LAUNCHER_DIR="$HOME/.local/libexec/debian-user-config-e2e"
    if [[ -L "$E2E_LIBVIRT_LAUNCHER_DIR" ]]; then
        echo "error: refusing to use symlinked E2E libvirt launcher directory" >&2
        exit 1
    elif [[ -e "$E2E_LIBVIRT_LAUNCHER_DIR" &&
        ! -d "$E2E_LIBVIRT_LAUNCHER_DIR" ]]; then
        echo "error: E2E libvirt launcher path is not a directory" >&2
        exit 1
    fi
    mkdir -p "$E2E_LIBVIRT_LAUNCHER_DIR"
    chmod 700 "$E2E_LIBVIRT_LAUNCHER_DIR"
    E2E_LIBVIRT_LAUNCHER="$E2E_LIBVIRT_LAUNCHER_DIR/copilot-e2e-libvirt"
    if [[ -L "$E2E_LIBVIRT_LAUNCHER" ]]; then
        echo "error: refusing to use symlinked E2E libvirt launcher" >&2
        exit 1
    elif [[ -e "$E2E_LIBVIRT_LAUNCHER" && ! -f "$E2E_LIBVIRT_LAUNCHER" ]]; then
        echo "error: E2E libvirt launcher path is not a regular file" >&2
        exit 1
    fi
    if [[ ! -e "$E2E_LIBVIRT_LAUNCHER" ]] ||
        ! cmp -s "$SCRIPT_DIR/copilot-e2e-libvirt" "$E2E_LIBVIRT_LAUNCHER"; then
        E2E_LIBVIRT_LAUNCHER_TEMP="$(mktemp "$E2E_LIBVIRT_LAUNCHER_DIR/.libvirt.XXXXXX")"
        cp "$SCRIPT_DIR/copilot-e2e-libvirt" "$E2E_LIBVIRT_LAUNCHER_TEMP"
        chmod 755 "$E2E_LIBVIRT_LAUNCHER_TEMP"
        mv -f "$E2E_LIBVIRT_LAUNCHER_TEMP" "$E2E_LIBVIRT_LAUNCHER"
    fi

    E2E_SUDO_CLIENT_DIR="$COPILOT_HOME/e2e-sudo"
    if [[ -L "$E2E_SUDO_CLIENT_DIR" ]]; then
        echo "error: refusing to use symlinked E2E sudo client directory: $E2E_SUDO_CLIENT_DIR" >&2
        exit 1
    fi
    mkdir -p "$E2E_SUDO_CLIENT_DIR"
    chmod 700 "$E2E_SUDO_CLIENT_DIR"
    E2E_SUDO_CLIENT="$E2E_SUDO_CLIENT_DIR/sudo"
    if [[ -L "$E2E_SUDO_CLIENT" ]]; then
        echo "error: refusing to use symlinked E2E sudo client: $E2E_SUDO_CLIENT" >&2
        exit 1
    elif [[ -e "$E2E_SUDO_CLIENT" && ! -f "$E2E_SUDO_CLIENT" ]]; then
        echo "error: E2E sudo client path is not a regular file: $E2E_SUDO_CLIENT" >&2
        exit 1
    fi
    if [[ ! -e "$E2E_SUDO_CLIENT" ]] ||
        ! cmp -s "$SCRIPT_DIR/copilot-e2e-sudo" "$E2E_SUDO_CLIENT"; then
        E2E_SUDO_CLIENT_TEMP="$(mktemp "$E2E_SUDO_CLIENT_DIR/.sudo.XXXXXX")"
        cp "$SCRIPT_DIR/copilot-e2e-sudo" "$E2E_SUDO_CLIENT_TEMP"
        chmod 755 "$E2E_SUDO_CLIENT_TEMP"
        mv -f "$E2E_SUDO_CLIENT_TEMP" "$E2E_SUDO_CLIENT"
    fi
    E2E_VIRSH_CLIENT="$E2E_SUDO_CLIENT_DIR/virsh"
    if [[ -L "$E2E_VIRSH_CLIENT" ]]; then
        echo "error: refusing to use symlinked E2E virsh client: $E2E_VIRSH_CLIENT" >&2
        exit 1
    elif [[ -e "$E2E_VIRSH_CLIENT" && ! -f "$E2E_VIRSH_CLIENT" ]]; then
        echo "error: E2E virsh client path is not a regular file: $E2E_VIRSH_CLIENT" >&2
        exit 1
    fi
    if [[ ! -e "$E2E_VIRSH_CLIENT" ]] ||
        ! cmp -s "$SCRIPT_DIR/copilot-e2e-virsh" "$E2E_VIRSH_CLIENT"; then
        E2E_VIRSH_CLIENT_TEMP="$(mktemp "$E2E_SUDO_CLIENT_DIR/.virsh.XXXXXX")"
        cp "$SCRIPT_DIR/copilot-e2e-virsh" "$E2E_VIRSH_CLIENT_TEMP"
        chmod 755 "$E2E_VIRSH_CLIENT_TEMP"
        mv -f "$E2E_VIRSH_CLIENT_TEMP" "$E2E_VIRSH_CLIENT"
    fi
    E2E_SUDO_CLIENT_BIND_ARGS=(--ro-bind "$E2E_SUDO_CLIENT_DIR" "$E2E_SUDO_CLIENT_DIR")
    SANDBOX_PATH="$E2E_SUDO_CLIENT_DIR:$SANDBOX_PATH"

    # Mount only the public key required by authd provisioning. If its file is
    # absent, a single loaded agent identity is sufficient to recreate it.
    AUTHD_E2E_SSH_PUBLIC_KEY="$HOME/.ssh/id_ed25519_canonical.pub"
    AUTHD_E2E_SSH_PUBLIC_KEY_SOURCE=
    if [[ -s "$AUTHD_E2E_SSH_PUBLIC_KEY" && -r "$AUTHD_E2E_SSH_PUBLIC_KEY" ]]; then
        AUTHD_E2E_SSH_PUBLIC_KEY_SOURCE="$(realpath "$AUTHD_E2E_SSH_PUBLIC_KEY")"
    else
        E2E_KEY_AGENT_SOCKET="${COPILOT_SSH_AUTH_SOCK:-${SSH_AUTH_SOCK:-}}"
        E2E_AGENT_KEYS=()
        if [[ -n "$E2E_KEY_AGENT_SOCKET" && -S "$E2E_KEY_AGENT_SOCKET" ]] &&
            command -v ssh-add >/dev/null 2>&1; then
            while IFS= read -r E2E_AGENT_KEY; do
                case "$E2E_AGENT_KEY" in
                    ssh-*|ecdsa-*|sk-*)
                        E2E_AGENT_KEYS+=("$E2E_AGENT_KEY")
                        ;;
                esac
            done < <(SSH_AUTH_SOCK="$E2E_KEY_AGENT_SOCKET" ssh-add -L 2>/dev/null || true)
        fi
        if [[ "${#E2E_AGENT_KEYS[@]}" -eq 1 ]]; then
            AUTHD_E2E_SSH_PUBLIC_KEY_SOURCE="$COPILOT_HOME/e2e-ssh-public-key"
            printf '%s\n' "${E2E_AGENT_KEYS[0]}" >"$AUTHD_E2E_SSH_PUBLIC_KEY_SOURCE"
            chmod 644 "$AUTHD_E2E_SSH_PUBLIC_KEY_SOURCE"
        fi
    fi
    if [[ -n "$AUTHD_E2E_SSH_PUBLIC_KEY_SOURCE" ]]; then
        E2E_SSH_PUBLIC_KEY_PARENT_ARGS=(--dir "$HOME/.ssh")
        E2E_SSH_PUBLIC_KEY_BIND_ARGS=(
            --ro-bind "$AUTHD_E2E_SSH_PUBLIC_KEY_SOURCE" "$AUTHD_E2E_SSH_PUBLIC_KEY"
        )
    else
        echo "warning: authd E2E SSH public key not found: $AUTHD_E2E_SSH_PUBLIC_KEY" >&2
        echo "warning: provisioning will require that file or exactly one loaded ssh-agent key" >&2
    fi
fi

# Keep the Secret Service database separate from the host keyring.
KEYRING_DATA_HOME="$COPILOT_HOME/keyring-data"
if [[ -L "$KEYRING_DATA_HOME" ]]; then
    echo "error: refusing to use symlinked private keyring storage: $KEYRING_DATA_HOME" >&2
    exit 1
fi
mkdir -p "$KEYRING_DATA_HOME"
chmod 700 "$KEYRING_DATA_HOME"

# Keep manually managed secrets separate from Copilot's mutable state.
SECRETS_HOME="$COPILOT_HOME/secrets"
if [[ -L "$SECRETS_HOME" ]]; then
    echo "error: refusing to use symlinked private secrets storage: $SECRETS_HOME" >&2
    exit 1
fi
mkdir -p "$SECRETS_HOME"
chmod 700 "$SECRETS_HOME"

# Keep GitHub CLI configuration inside Copilot's state.
GH_CONFIG_HOME="$COPILOT_HOME/gh-config"
if [[ -L "$GH_CONFIG_HOME" ]]; then
    echo "error: refusing to use symlinked GitHub CLI configuration: $GH_CONFIG_HOME" >&2
    exit 1
fi
mkdir -p "$GH_CONFIG_HOME"
chmod 700 "$GH_CONFIG_HOME"

# Reserve the container policy mount point. The actual policy is generated in
# the sandbox tmpfs below so Copilot cannot persistently change host policy.
CONTAINERS_CONFIG_HOME="$COPILOT_HOME/config/containers"
if [[ -L "$CONTAINERS_CONFIG_HOME" ]]; then
    echo "error: refusing to use symlinked container configuration: $CONTAINERS_CONFIG_HOME" >&2
    exit 1
fi
mkdir -p "$CONTAINERS_CONFIG_HOME"
chmod 700 "$CONTAINERS_CONFIG_HOME"

# Keep rootless Podman storage separate from the keyring and other Copilot
# state. The storage configuration itself is generated inside the sandbox's
# private tmpfs below.
PODMAN_STORAGE_HOME="$COPILOT_HOME/podman-storage"
if [[ -L "$PODMAN_STORAGE_HOME" ]]; then
    echo "error: refusing to use symlinked Podman storage: $PODMAN_STORAGE_HOME" >&2
    exit 1
elif [[ -e "$PODMAN_STORAGE_HOME" && ! -d "$PODMAN_STORAGE_HOME" ]]; then
    echo "error: Podman storage path is not a directory: $PODMAN_STORAGE_HOME" >&2
    exit 1
fi
mkdir -p "$PODMAN_STORAGE_HOME"
chmod 700 "$PODMAN_STORAGE_HOME"

# Keep uv-managed Python installations separate from the keyring database and
# available to virtual environments created inside the sandbox.
UV_PYTHON_HOME="$COPILOT_HOME/uv-python"
if [[ -L "$UV_PYTHON_HOME" ]]; then
    echo "error: refusing to use symlinked uv Python storage: $UV_PYTHON_HOME" >&2
    exit 1
elif [[ -e "$UV_PYTHON_HOME" && ! -d "$UV_PYTHON_HOME" ]]; then
    echo "error: uv Python storage path is not a directory: $UV_PYTHON_HOME" >&2
    exit 1
fi
mkdir -p "$UV_PYTHON_HOME"
chmod 700 "$UV_PYTHON_HOME"

# Existing virtual environments may point at a host-managed uv interpreter.
UV_HOST_PYTHON_BIND_ARGS=()
if [[ -d "$HOME/.local/share/uv/python" ]]; then
    UV_HOST_PYTHON_BIND_ARGS=(
        --ro-bind "$HOME/.local/share/uv/python" "$HOME/.local/share/uv/python"
    )
fi

# Expose Git's global configuration at its normal path as a read-only
# snapshot. Reading through a file descriptor also supports symlinked dotfile
# installations while snapshotting the file.
GIT_CONFIG_PATH="$HOME/.gitconfig"
GIT_CONFIG_BIND_ARGS=()
if [[ -L "$GIT_CONFIG_PATH" || -e "$GIT_CONFIG_PATH" ]]; then
    if [[ ! -f "$GIT_CONFIG_PATH" || ! -r "$GIT_CONFIG_PATH" ]]; then
        echo "error: Git config is not a readable regular file: $GIT_CONFIG_PATH" >&2
        exit 1
    fi
    exec 11< "$GIT_CONFIG_PATH"
    GIT_CONFIG_BIND_ARGS=(--ro-bind-data 11 "$GIT_CONFIG_PATH")
fi

# Prefer an explicitly selected socket, then the dedicated Copilot socket,
# then the host's current SSH agent. Set COPILOT_SSH_AUTH_SOCK to override
# both defaults.
SSH_AGENT_SOCKET=
SSH_AGENT_BIND_ARGS=()
SSH_AGENT_ENABLED=false
if [[ -n "${COPILOT_SSH_AUTH_SOCK:-}" ]]; then
    SSH_AGENT_SOCKET="$COPILOT_SSH_AUTH_SOCK"
elif [[ -e "$COPILOT_HOME/ssh-agent.sock" || -L "$COPILOT_HOME/ssh-agent.sock" ]]; then
    SSH_AGENT_SOCKET="$COPILOT_HOME/ssh-agent.sock"
elif [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    SSH_AGENT_SOCKET="$SSH_AUTH_SOCK"
fi
if [[ -n "$SSH_AGENT_SOCKET" ]]; then
    if [[ ! -S "$SSH_AGENT_SOCKET" ]]; then
        echo "error: SSH agent path is not a Unix socket: $SSH_AGENT_SOCKET" >&2
        exit 1
    fi
    SSH_AGENT_BIND_ARGS=(--bind "$SSH_AGENT_SOCKET" /tmp/copilot-runtime/ssh-agent)
    SSH_AGENT_ENABLED=true
fi

# Expose SSH host keys without exposing the rest of ~/.ssh.
SSH_KNOWN_HOSTS="$HOME/.ssh/known_hosts"
SSH_KNOWN_HOSTS_BIND_ARGS=()
if [[ -L "$SSH_KNOWN_HOSTS" ]]; then
    echo "error: refusing to use symlinked SSH known_hosts: $SSH_KNOWN_HOSTS" >&2
    exit 1
elif [[ -e "$SSH_KNOWN_HOSTS" ]]; then
    if [[ ! -f "$SSH_KNOWN_HOSTS" || ! -r "$SSH_KNOWN_HOSTS" ]]; then
        echo "error: SSH known_hosts is not a readable regular file: $SSH_KNOWN_HOSTS" >&2
        exit 1
    fi
    SSH_KNOWN_HOSTS_BIND_ARGS=(--ro-bind "$SSH_KNOWN_HOSTS" "$SSH_KNOWN_HOSTS")
fi

# Expose the native Wayland clipboard connection without exposing the host
# runtime directory.
WAYLAND_SOCKET_BIND_ARGS=()
WAYLAND_DISPLAY_IN_SANDBOX=
WAYLAND_SOCKET_TARGET=
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    if [[ "$WAYLAND_DISPLAY" == /* ]]; then
        WAYLAND_SOCKET="$WAYLAND_DISPLAY"
        WAYLAND_DISPLAY_IN_SANDBOX=/tmp/copilot-runtime/wayland
        WAYLAND_SOCKET_TARGET="$WAYLAND_DISPLAY_IN_SANDBOX"
    else
        if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
            echo "error: XDG_RUNTIME_DIR is required for the Wayland display socket" >&2
            exit 1
        fi
        WAYLAND_SOCKET="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
        WAYLAND_DISPLAY_IN_SANDBOX="$WAYLAND_DISPLAY"
        if [[ "$WAYLAND_DISPLAY" == */* ]]; then
            echo "error: unsupported Wayland display name: $WAYLAND_DISPLAY" >&2
            exit 1
        fi
        WAYLAND_SOCKET_TARGET="/tmp/copilot-runtime/$WAYLAND_DISPLAY"
    fi
    if [[ ! -S "$WAYLAND_SOCKET" ]]; then
        echo "error: Wayland display path is not a Unix socket: $WAYLAND_SOCKET" >&2
        exit 1
    fi
    WAYLAND_SOCKET_BIND_ARGS=(--bind "$WAYLAND_SOCKET" "$WAYLAND_SOCKET_TARGET")
fi

# Expose the X11 socket directory for recorders and X11-based tools without
# exposing the rest of the host's /tmp.
X11_SOCKET_BIND_ARGS=(--dir /tmp/.X11-unix)
if [[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]]; then
    X11_SOCKET_BIND_ARGS+=(--bind /tmp/.X11-unix /tmp/.X11-unix)
fi

# dbus-daemon requires a passwd and group entry for the sandboxed UID. The
# host's NSS configuration provides those entries, but they are not always in
# /etc/passwd and /etc/group.
GROUP_ID="$(id -g)"
if ! CURRENT_USER_ENTRY="$(getent passwd "$USER_ID")"; then
    CURRENT_USER_ENTRY=
fi
if ! CURRENT_GROUP_ENTRY="$(getent group "$GROUP_ID")"; then
    CURRENT_GROUP_ENTRY=
fi
if [[ -z "$CURRENT_USER_ENTRY" || -z "$CURRENT_GROUP_ENTRY" ]]; then
    echo "error: could not resolve the current user for the private D-Bus session" >&2
    exit 1
fi
exec 9< <(cat /etc/passwd; printf '%s\n' "$CURRENT_USER_ENTRY")
exec 10< <(cat /etc/group; printf '%s\n' "$CURRENT_GROUP_ENTRY")

# Podman needs a local timezone file during engine initialization. Prefer the
# host timezone, falling back to UTC on minimal hosts without /etc/localtime.
LOCALTIME_BIND_ARGS=()
if [[ -e /etc/localtime ]]; then
    LOCALTIME_PATH="$(realpath /etc/localtime)"
    if [[ ! -f "$LOCALTIME_PATH" || ! -r "$LOCALTIME_PATH" ]]; then
        echo "error: local timezone path is not a readable regular file: $LOCALTIME_PATH" >&2
        exit 1
    fi
    LOCALTIME_BIND_ARGS=(--ro-bind "$LOCALTIME_PATH" /etc/localtime)
elif [[ -f /usr/share/zoneinfo/UTC ]]; then
    LOCALTIME_BIND_ARGS=(--ro-bind /usr/share/zoneinfo/UTC /etc/localtime)
else
    echo "error: could not find a timezone file for the sandbox" >&2
    exit 1
fi

# Resolve this symlink before binding the release file into the sandbox.
OS_RELEASE_PATH="$(realpath /etc/os-release)"
if [[ ! -f "$OS_RELEASE_PATH" || ! -r "$OS_RELEASE_PATH" ]]; then
    echo "error: os-release path is not a readable regular file: $OS_RELEASE_PATH" >&2
    exit 1
fi

# authd tests copy these host files into nested bubblewrap sandboxes.
# Nested tests inherit the scoped AppArmor profile from the authd-only bwrap.
AUTHD_TEST_EXTENDED_USERNS=false
AUTHD_TEST_BWRAP_BIN=
AUTHD_TEST_BWRAP_BIND_ARGS=()
AUTHD_TEST_CONFIG_BIND_ARGS=()
AUTHD_TEST_ENV_ARGS=()
AUTHD_TEST_CAP_ARGS=()
AUTHD_TEST_CAP_DROP_ARGS=()
AUTHD_TEST_GO_BIND_ARGS=()
AUTHD_TEST_GO_TOOLCHAIN_DIR=
AUTHD_TEST_RUST_BIND_ARGS=()
AUTHD_TEST_RUST_TOOLCHAIN_DIR=
AUTHD_TEST_CARGO_CACHE_BIND_ARGS=()
AUTHD_TEST_PRIVATE_FIXTURE_BIND_ARGS=()
AUTHD_TEST_PRIVATE_FIXTURE_FILES=()
AUTHD_TEST_PRIVATE_FIXTURE_DIR=
CRACKLIB_BIND_ARGS=()

cleanup_authd_test_private_fixtures() {
    local fixture_file
    for fixture_file in "${AUTHD_TEST_PRIVATE_FIXTURE_FILES[@]}"; do
        rm -f -- "$fixture_file"
    done
    if [[ -n "$AUTHD_TEST_PRIVATE_FIXTURE_DIR" ]]; then
        rmdir -- "$AUTHD_TEST_PRIVATE_FIXTURE_DIR"
    fi
}

if [[ -f "$MOUNT_DIR/go.mod" ]] &&
    grep -q '^module github.com/canonical/authd$' "$MOUNT_DIR/go.mod"; then
    AUTHD_TEST_ENV_ARGS=(
        --setenv AUTHD_SKIP_ROOT_TESTS 1
    )
    if command -v go >/dev/null 2>&1 &&
        AUTHD_TEST_GO_TOOLCHAIN_DIR="$(cd "$MOUNT_DIR" && go env GOROOT 2>/dev/null)" &&
        [[ -x "$AUTHD_TEST_GO_TOOLCHAIN_DIR/bin/go" ]]; then
        AUTHD_TEST_GO_TOOLCHAIN_DIR="$(realpath "$AUTHD_TEST_GO_TOOLCHAIN_DIR")"
        AUTHD_TEST_GO_BIND_ARGS=(
            --dir /opt
            --ro-bind "$AUTHD_TEST_GO_TOOLCHAIN_DIR" /opt/copilot-go-toolchain
            --dir /workspace
            --bind "$MOUNT_DIR" /workspace/authd
        )
        AUTHD_TEST_ENV_ARGS+=(
            --setenv AUTHD_TEST_GO_TOOLCHAIN /opt/copilot-go-toolchain
            --setenv AUTHD_TEST_REPO_ROOT "$MOUNT_DIR"
            --setenv AUTHD_TEST_REPO_ALIAS /workspace/authd
            --setenv AUTHD_TEST_USER_NAME "${CURRENT_USER_ENTRY%%:*}"
            --setenv AUTHD_TEST_USER_UID "$USER_ID"
            --setenv AUTHD_TEST_USER_GID "$GROUP_ID"
            --setenv AUTHD_TEST_CARGO_HOME "$HOME/.cargo"
            --setenv AUTHD_TEST_RUSTUP_HOME "$HOME/.rustup"
        )
    fi
    if command -v rustup >/dev/null 2>&1 &&
        AUTHD_TEST_RUSTC_PATH="$(rustup which rustc 2>/dev/null)" &&
        [[ -x "$AUTHD_TEST_RUSTC_PATH" ]]; then
        AUTHD_TEST_RUST_TOOLCHAIN_DIR="$(dirname "$(dirname "$AUTHD_TEST_RUSTC_PATH")")"
        AUTHD_TEST_RUST_TOOLCHAIN_DIR="$(realpath "$AUTHD_TEST_RUST_TOOLCHAIN_DIR")"
        AUTHD_TEST_RUST_BIND_ARGS=(
            --dir /opt
            --ro-bind "$AUTHD_TEST_RUST_TOOLCHAIN_DIR" /opt/copilot-rust-toolchain
        )
        AUTHD_TEST_ENV_ARGS+=(--setenv AUTHD_TEST_RUST_TOOLCHAIN /opt/copilot-rust-toolchain)
        AUTHD_TEST_CARGO_CACHE_BIND_ARGS=(
            --dir /opt
            --ro-bind "$CARGO_REGISTRY_CACHE_DIR" /opt/copilot-cargo-registry
        )
        if [[ -d "$CARGO_GIT_CACHE_DIR" ]]; then
            AUTHD_TEST_CARGO_CACHE_BIND_ARGS+=(--ro-bind "$CARGO_GIT_CACHE_DIR" /opt/copilot-cargo-git)
            AUTHD_TEST_ENV_ARGS+=(--setenv AUTHD_TEST_CARGO_GIT /opt/copilot-cargo-git)
        fi
        AUTHD_TEST_ENV_ARGS+=(--setenv AUTHD_TEST_CARGO_REGISTRY /opt/copilot-cargo-registry)
        SANDBOX_PATH="/opt/copilot-rust-toolchain/bin:$SANDBOX_PATH"
    fi
    AUTHD_TEST_CAP_DROP_ARGS=(--cap-drop CAP_DAC_OVERRIDE)
    AUTHD_TEST_CONFIG_BIND_ARGS+=(
        --dir /run
        --dir /run/sshd
        --chmod 755 /run/sshd
    )
    if /usr/bin/unshare --user --map-root-user --map-users=auto --map-groups=auto -- /usr/bin/true >/dev/null 2>&1; then
        AUTHD_TEST_EXTENDED_USERNS=true
        AUTHD_TEST_POLICY_FILE=/etc/apparmor.d/debian-user-config-copilot-authd-tests
        if [[ ! -r "$AUTHD_TEST_POLICY_FILE" ]] ||
            ! grep -Fq '@{HOME}/.local/libexec/debian-user-config/copilot-authd-tests-bwrap' "$AUTHD_TEST_POLICY_FILE"; then
            echo "error: install the authd test AppArmor profile with sudo $SCRIPT_DIR/../apparmor/install.sh" >&2
            exit 1
        fi
        if [[ -L "$PODMAN_BIN_DIR" ]]; then
            echo "error: refusing to use symlinked authd test launcher directory: $PODMAN_BIN_DIR" >&2
            exit 1
        elif [[ -e "$PODMAN_BIN_DIR" && ! -d "$PODMAN_BIN_DIR" ]]; then
            echo "error: authd test launcher path is not a directory: $PODMAN_BIN_DIR" >&2
            exit 1
        fi
        mkdir -p "$PODMAN_BIN_DIR"
        chmod 700 "$PODMAN_BIN_DIR"
        AUTHD_TEST_BWRAP_BIN="$PODMAN_BIN_DIR/copilot-authd-tests-bwrap"
        BWRAP_SOURCE="$(realpath "$BWRAP_BIN")"
        if [[ ! -f "$BWRAP_SOURCE" || ! -x "$BWRAP_SOURCE" ]]; then
            echo "error: bubblewrap is not a readable regular executable: $BWRAP_SOURCE" >&2
            exit 1
        fi
        if [[ -L "$AUTHD_TEST_BWRAP_BIN" ]]; then
            echo "error: refusing to use a symlinked authd test launcher: $AUTHD_TEST_BWRAP_BIN" >&2
            exit 1
        elif [[ -e "$AUTHD_TEST_BWRAP_BIN" && ! -f "$AUTHD_TEST_BWRAP_BIN" ]]; then
            echo "error: authd test launcher is not a regular file: $AUTHD_TEST_BWRAP_BIN" >&2
            exit 1
        fi
        if [[ "$BWRAP_SOURCE" != "$AUTHD_TEST_BWRAP_BIN" ]] &&
            { [[ ! -e "$AUTHD_TEST_BWRAP_BIN" ]] || ! cmp -s "$BWRAP_SOURCE" "$AUTHD_TEST_BWRAP_BIN"; }; then
            AUTHD_TEST_BWRAP_TEMP="$(mktemp "$PODMAN_BIN_DIR/.copilot-authd-tests-bwrap.XXXXXX")"
            cp "$BWRAP_SOURCE" "$AUTHD_TEST_BWRAP_TEMP"
            chmod 755 "$AUTHD_TEST_BWRAP_TEMP"
            mv -f "$AUTHD_TEST_BWRAP_TEMP" "$AUTHD_TEST_BWRAP_BIN"
        fi
        PODMAN_BIN_DIR="$(realpath "$PODMAN_BIN_DIR")"
        AUTHD_TEST_BWRAP_BIN="$(realpath "$AUTHD_TEST_BWRAP_BIN")"
        if [[ "${#PODMAN_BIND_ARGS[@]}" -eq 0 ]]; then
            AUTHD_TEST_BWRAP_BIND_ARGS=(--ro-bind "$PODMAN_BIN_DIR" "$PODMAN_BIN_DIR")
        fi
        AUTHD_TEST_CAP_ARGS=(
            --cap-add CAP_CHOWN
            --cap-add CAP_FOWNER
            --cap-add CAP_FSETID
            --cap-add CAP_SETFCAP
        )
        exec 12< <(awk -F: '$1 != "root" {print} END {print "root:1:65535"}' /etc/subuid)
        exec 13< <(awk -F: '$1 != "root" {print} END {print "root:1:65535"}' /etc/subgid)
        AUTHD_TEST_CONFIG_BIND_ARGS+=(
            --perms 0644
            --ro-bind-data 12 /etc/subuid
            --perms 0644
            --ro-bind-data 13 /etc/subgid
        )

    else
        echo "warning: subordinate UID/GID mappings are unavailable; nested authd Go tests may fail" >&2
    fi
    if [[ "$AUTHD_TEST_EXTENDED_USERNS" == true ]]; then
        AUTHD_TEST_ENV_ARGS+=(--setenv AUTHD_TEST_NESTED_USERNS_MAP explicit)
    else
        AUTHD_TEST_ENV_ARGS+=(--setenv AUTHD_TEST_NESTED_USERNS_MAP single)
    fi
    for etc_path in \
        /etc/environment \
        /etc/login.defs \
        /etc/pam.d \
        /etc/security \
        /etc/shells \
        /etc/sudoers
    do
        if [[ -e "$etc_path" ]]; then
            AUTHD_TEST_CONFIG_BIND_ARGS+=(--ro-bind "$(realpath "$etc_path")" "$etc_path")
        fi
    done
    if [[ "$AUTHD_TEST_EXTENDED_USERNS" != true ]]; then
        for etc_path in /etc/subgid /etc/subuid; do
            if [[ -e "$etc_path" ]]; then
                AUTHD_TEST_CONFIG_BIND_ARGS+=(--ro-bind "$(realpath "$etc_path")" "$etc_path")
            fi
        done
    fi

    if [[ -d /etc/skel ]]; then
        AUTHD_TEST_CONFIG_BIND_ARGS+=(--dir /etc/skel)
        for skel_file in /etc/skel/.bashrc /etc/skel/.profile; do
            if [[ -f "$skel_file" ]]; then
                AUTHD_TEST_CONFIG_BIND_ARGS+=(--ro-bind "$(realpath "$skel_file")" "$skel_file")
            fi
        done
    fi

    if [[ -d /var/cache/cracklib ]]; then
        CRACKLIB_CACHE_DIR="$(realpath /var/cache/cracklib)"
        CRACKLIB_BIND_ARGS=(--dir /var/cache --ro-bind "$CRACKLIB_CACHE_DIR" /var/cache/cracklib)
    fi
fi

# Expose the host package database read-only so dpkg-query and
# dpkg-checkbuilddeps can recognize packages whose files are already visible
# under /usr. Package installation remains unavailable: apt state is not
# exposed and the system paths are mounted read-only.
DPKG_STATE_BIND_ARGS=()
if [[ -f /var/lib/dpkg/status && -r /var/lib/dpkg/status ]]; then
    DPKG_STATE_DIR="$(realpath /var/lib/dpkg)"
    DPKG_STATE_BIND_ARGS=(
        --dir /var
        --dir /var/lib
        --ro-bind "$DPKG_STATE_DIR" /var/lib/dpkg
    )
fi

