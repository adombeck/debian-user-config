if [[ "$ALLOW_E2E_TESTS" == true ]]; then
    E2E_SUDO_SOCKET_DIR="$(mktemp -d "$COPILOT_HOME/.e2e-sudo.XXXXXXXX")"
    chmod 700 "$E2E_SUDO_SOCKET_DIR"
    E2E_SUDO_SOCKET="$E2E_SUDO_SOCKET_DIR/sock"
    E2E_SUDO_ALLOWED_IMAGE_ROOTS=("$AUTHD_E2E_DATA_HOST_DIR")
    SANDBOX_ENV_ARGS+=(--setenv COPILOT_E2E_SUDO_SOCKET "$E2E_SUDO_SOCKET")

    if ! e2e_libvirt_start_or_join; then
        exit 1
    fi
    printf 'Connect with: virt-manager --connect %q\n' \
        "qemu+unix:///session?socket=$E2E_LIBVIRT_SOCKET_DIR/libvirt-sock"

    shopt -s nullglob
    for domain_xml in "$AUTHD_E2E_DATA_HOST_DIR"/*/*.xml; do
        if [[ ! -f "$domain_xml" ]]; then
            continue
        fi
        if ! domain_name="$(/usr/bin/xmllint --xpath 'string(/domain/name)' "$domain_xml" 2>/dev/null)" ||
            [[ -z "$domain_name" ]]; then
            echo "error: could not read E2E domain name from: $domain_xml" >&2
            exit 1
        fi
        release_name="$(basename "$(dirname "$domain_xml")")"
        expected_domain="$(basename "$domain_xml" .xml)-$release_name"
        if [[ "$domain_name" != "$expected_domain" ]]; then
            echo "warning: skipping E2E VM definition with unexpected name: $domain_xml" >&2
            continue
        fi
        if ! e2e_libvirt_virsh dominfo "$domain_name" >/dev/null 2>&1 &&
            ! e2e_libvirt_virsh define "$domain_xml" >/dev/null; then
            echo "error: could not restore E2E VM definition: $domain_xml" >&2
            exit 1
        fi
    done
    shopt -u nullglob
    e2e_libvirt_unlock_manager

    E2E_SUDO_HELPER_LOG="$(mktemp "$E2E_LIBVIRT_MANAGER_DIR/sudo-helper.XXXXXXXX")"
    "$SCRIPT_DIR/copilot-e2e-sudo-helper" \
        "$E2E_SUDO_SOCKET" \
        "$AUTHD_E2E_DATA_HOST_DIR" \
        "${E2E_SUDO_ALLOWED_IMAGE_ROOTS[@]}" \
        >"$E2E_SUDO_HELPER_LOG" 2>&1 &
    E2E_SUDO_HELPER_PID=$!
    E2E_SUDO_HELPER_READY=false
    for ((attempt = 0; attempt < 100; attempt++)); do
        if [[ -S "$E2E_SUDO_SOCKET" ]]; then
            E2E_SUDO_HELPER_READY=true
            break
        fi
        if ! kill -0 "$E2E_SUDO_HELPER_PID" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if [[ "$E2E_SUDO_HELPER_READY" != true ]]; then
        echo "error: could not initialize the host-side E2E sudo helper" >&2
        if [[ -s "$E2E_SUDO_HELPER_LOG" ]]; then
            cat "$E2E_SUDO_HELPER_LOG" >&2
        fi
        exit 1
    fi
fi

# Keep only capabilities needed by the nested OCI runtime; they are scoped to
# the bwrap user namespace and do not grant host capabilities.
# Hide the persistent policy directory with a sandbox-only tmpfs. A bwrap
# --bind source must exist outside the sandbox, so a directory created with
# --dir under /tmp cannot be used as that source.
# Interactive shells need the caller's terminal session for job control.
BWRAP_SESSION_ARGS=(--new-session)
if [[ "$RUN_INTERACTIVE_SHELL" == true ]]; then
    BWRAP_SESSION_ARGS=()
fi

# Keep the wider UID/GID map limited to authd worktrees with nested userns tests.
BWRAP_COMMAND=("$BWRAP_BIN")
BWRAP_NAMESPACE_ARGS=(--unshare-all --share-net)
if [[ "$AUTHD_TEST_EXTENDED_USERNS" == true ]]; then
    BWRAP_COMMAND=(
        /usr/bin/unshare
        --user
        --map-root-user
        --map-users=auto
        --map-groups=auto
        --
        "$AUTHD_TEST_BWRAP_BIN"
    )
    BWRAP_NAMESPACE_ARGS=(
        --unshare-ipc
        --unshare-pid
        --unshare-uts
        --unshare-cgroup-try
    )
fi

if [[ -n "$AUTHD_TEST_GO_TOOLCHAIN_DIR" ]]; then
    AUTHD_TEST_PRIVATE_FIXTURE_DIR="$(mktemp -d "$COPILOT_HOME/authd-test-fixtures.XXXXXXXX")"
    chmod 700 "$AUTHD_TEST_PRIVATE_FIXTURE_DIR"
    private_fixture_index=0
    while IFS= read -r -d '' private_fixture; do
        private_fixture_copy="$AUTHD_TEST_PRIVATE_FIXTURE_DIR/$private_fixture_index"
        if ! cp -- "$private_fixture" "$private_fixture_copy"; then
            rm -f -- "$private_fixture_copy"
            cleanup_authd_test_private_fixtures
            echo "error: could not stage authd test fixture: $private_fixture" >&2
            exit 1
        fi
        AUTHD_TEST_PRIVATE_FIXTURE_FILES+=("$private_fixture_copy")
        if ! chmod 644 "$private_fixture_copy"; then
            cleanup_authd_test_private_fixtures
            echo "error: could not make staged authd test fixture readable" >&2
            exit 1
        fi
        private_fixture_relative="${private_fixture#"$MOUNT_DIR"}"
        AUTHD_TEST_PRIVATE_FIXTURE_BIND_ARGS+=(
            --ro-bind "$private_fixture_copy" "/workspace/authd$private_fixture_relative"
        )
        private_fixture_index=$((private_fixture_index + 1))
    done < <(
        find "$MOUNT_DIR" \
            -path "$MOUNT_DIR/.git" -prune -o \
            -path "$MOUNT_DIR/authd-oidc-brokers" -prune -o \
            -path '*/testdata/*' -type f ! -perm /044 -print0
    )
fi

