    --tmpfs /tmp \
    --chmod 1777 /tmp \
    "${AUTHD_E2E_SESSION_VM_HELPER_BIND_ARGS[@]}" \
    "${X11_SOCKET_BIND_ARGS[@]}" \
    --dir /tmp/copilot-runtime \
    --chmod 700 /tmp/copilot-runtime \
    --dir /tmp/copilot-runtime/tmp \
    --dir /sys \
    --dir /sys/fs \
    --dir /sys/fs/cgroup \
    "${DPKG_STATE_BIND_ARGS[@]}" \
    "${CRACKLIB_BIND_ARGS[@]}" \
    --dir /var/run/libvirt \
    "${AUTHD_E2E_TEST_RUNS_PARENT_ARGS[@]}" \
    "${LIBVIRT_BIND_ARGS[@]}" \
    "${E2E_LIBVIRT_SOCKET_BIND_ARGS[@]}" \
    "${WAYLAND_SOCKET_BIND_ARGS[@]}" \
