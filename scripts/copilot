    \
    --bind "$PROJECTS_DIR" "$PROJECTS_DIR" \
    "${EXTRA_BIND_ARGS[@]}" \
    "${AUTHD_TEST_GO_BIND_ARGS[@]}" \
    "${AUTHD_TEST_RUST_BIND_ARGS[@]}" \
    "${AUTHD_TEST_CARGO_CACHE_BIND_ARGS[@]}" \
    --bind "$COPILOT_HOME" "$COPILOT_HOME" \
    "${SHARED_CACHE_OVERLAY_ARGS[@]}" \
    "${AUTHD_TEST_PRIVATE_FIXTURE_BIND_ARGS[@]}" \
    "${E2E_SUDO_CLIENT_BIND_ARGS[@]}" \
    "${E2E_SSH_PUBLIC_KEY_PARENT_ARGS[@]}" \
    "${E2E_SSH_PUBLIC_KEY_BIND_ARGS[@]}" \
    "${AUTHD_E2E_DATA_BIND_ARGS[@]}" \
    "${AUTHD_E2E_SESSION_DATA_BIND_ARGS[@]}" \
    "${AUTHD_E2E_TEST_RUNS_BIND_ARGS[@]}" \
    "${AUTHD_ARTIFACTS_BIND_ARGS[@]}" \
    "${AUTHD_E2E_ARTIFACTS_BIND_ARGS[@]}" \
    --tmpfs "$CONTAINERS_CONFIG_HOME" \
    --ro-bind "$SECRETS_HOME" "$SECRETS_HOME" \
    \
    --chdir "$WORKDIR" \
    /usr/bin/bash -c '
        set -euo pipefail

        dbus_pid=
        keyring_pid=
        cleanup() {
            if [[ -n "$keyring_pid" ]] && kill -0 "$keyring_pid" 2>/dev/null; then
                kill "$keyring_pid" 2>/dev/null || true
                wait "$keyring_pid" 2>/dev/null || true
            fi
            if [[ -n "$dbus_pid" ]] && kill -0 "$dbus_pid" 2>/dev/null; then
                kill "$dbus_pid" 2>/dev/null || true
                wait "$dbus_pid" 2>/dev/null || true
            fi
        }
        trap cleanup EXIT

        /usr/bin/dbus-daemon \
            --session --nofork --nosyslog --print-address=1 \
            >/tmp/copilot-dbus-address \
            2>/tmp/copilot-dbus.err &
        dbus_pid=$!

        dbus_ready=false
        for ((attempt = 0; attempt < 100; attempt++)); do
            if ! kill -0 "$dbus_pid" 2>/dev/null; then
                break
            fi
            if [[ -s /tmp/copilot-dbus-address ]]; then
                dbus_ready=true
                break
            fi
            /usr/bin/sleep 0.05
        done
        if [[ "$dbus_ready" != true ]]; then
            echo "error: could not initialize the private D-Bus session" >&2
            /usr/bin/cat /tmp/copilot-dbus.err >&2
            exit 1
        fi
        export DBUS_SESSION_BUS_ADDRESS="$(/usr/bin/cat /tmp/copilot-dbus-address)"

        printf "\n" >/tmp/copilot-keyring-password
        /usr/bin/gnome-keyring-daemon \
            --foreground --unlock --components=secrets \
            </tmp/copilot-keyring-password \
            >/tmp/copilot-keyring-daemon.out \
            2>/tmp/copilot-keyring-daemon.err &
        keyring_pid=$!

        keyring_ready=false
        for ((attempt = 0; attempt < 100; attempt++)); do
            if ! kill -0 "$keyring_pid" 2>/dev/null; then
                break
            fi
            if /usr/bin/dbus-send --session --print-reply \
                --dest=org.freedesktop.DBus \
                /org/freedesktop/DBus \
                org.freedesktop.DBus.NameHasOwner \
                string:org.freedesktop.secrets 2>/dev/null |
                /usr/bin/grep -q "boolean true"
            then
                keyring_ready=true
                break
            fi
            /usr/bin/sleep 0.05
        done

        if [[ "$keyring_ready" != true ]]; then
            echo "error: could not initialize the private Copilot keyring" >&2
            /usr/bin/cat /tmp/copilot-keyring-daemon.out >&2
            /usr/bin/cat /tmp/copilot-keyring-daemon.err >&2
            exit 1
        fi

        # Keep containers in the bwrap user namespace without requiring
        # subordinate UID/GID mappings, host cgroups, or /dev/fuse.
        /usr/bin/mkdir -p "$XDG_RUNTIME_DIR/podman"
        printf "%s\n" \
            "[containers]" \
            "userns = \"host\"" \
            "cgroups = \"disabled\"" \
            "" \
            "[engine]" \
            "cgroup_manager = \"cgroupfs\"" \
            "remote = false" \
            >/tmp/copilot-runtime/containers.conf
        printf "%s\n" \
            "[storage]" \
            "driver = \"vfs\"" \
            "rootless_storage_path = \"\$COPILOT_HOME/podman-storage\"" \
            "runroot = \"\$XDG_RUNTIME_DIR/podman\"" \
            "" \
            "[storage.options.vfs]" \
            "ignore_chown_errors = \"true\"" \
            >/tmp/copilot-runtime/storage.conf
        printf "%s\n" \
            "{" \
            "  \"default\": [{\"type\": \"reject\"}]," \
            "  \"transports\": {" \
            "    \"docker\": {" \
            "      \"docker.io\": [{\"type\": \"insecureAcceptAnything\"}]" \
            "    }" \
            "  }" \
            "}" \
            >"$COPILOT_HOME/config/containers/policy.json"

        github_token_file="$COPILOT_HOME/secrets/github-token"
        if [[ -e "$github_token_file" || -L "$github_token_file" ]]; then
            if [[ ! -f "$github_token_file" || ! -r "$github_token_file" ]]; then
                echo "error: GitHub token file is not a readable regular file: $github_token_file" >&2
                exit 1
            fi
            GH_TOKEN="$(<"$github_token_file")"
            if [[ -z "$GH_TOKEN" ]]; then
                echo "error: GitHub token file is empty: $github_token_file" >&2
                exit 1
            fi
            export GH_TOKEN
        fi

        jira_token_file="$COPILOT_HOME/secrets/jira-token"
        if [[ -e "$jira_token_file" || -L "$jira_token_file" ]]; then
            if [[ ! -f "$jira_token_file" || ! -r "$jira_token_file" ]]; then
                echo "error: Jira token file is not a readable regular file: $jira_token_file" >&2
                exit 1
            fi
            JIRA_API_TOKEN="$(<"$jira_token_file")"
            if [[ -z "$JIRA_API_TOKEN" ]]; then
                echo "error: Jira token file is empty: $jira_token_file" >&2
                exit 1
            fi
            export JIRA_API_TOKEN
        fi

        # A failed Git status breaks automatic VCS stamping. Single-package
        # execution also avoids exhausting the sandbox pipe quota in Go tests.
        if [[ -f go.mod ]] && ! /usr/bin/git status --porcelain >/dev/null 2>&1; then
            GOFLAGS="${GOFLAGS:+$GOFLAGS }-buildvcs=false -p=1"
            export GOFLAGS
            echo "warning: Git status failed; disabling Go VCS stamping and limiting Go package parallelism" >&2
        fi

        if [[ -n "${AUTHD_TEST_GO_TOOLCHAIN:-}" ]]; then
            authd_test_root=/tmp/copilot-authd-test
            authd_test_bin_dir="$authd_test_root/bin"
            /usr/bin/mkdir -p \
                "$authd_test_bin_dir" \
                "$authd_test_root/home" \
                "$authd_test_root/cache" \
                "$authd_test_root/config" \
                "$authd_test_root/data" \
                "$authd_test_root/runtime" \
                "$authd_test_root/gocache" \
                "$authd_test_root/gomodcache" \
                "$authd_test_root/cargo"
            /usr/bin/chmod 755 "$authd_test_root" "$authd_test_bin_dir"
            for cargo_cache in registry git; do
                cargo_cache_source="${AUTHD_TEST_CARGO_REGISTRY:-}"
                if [[ "$cargo_cache" == git ]]; then
                    cargo_cache_source="${AUTHD_TEST_CARGO_GIT:-}"
                fi
                if [[ -n "$cargo_cache_source" && -d "$cargo_cache_source" ]]; then
                    /usr/bin/ln -s "$cargo_cache_source" "$authd_test_root/cargo/$cargo_cache"
                fi
            done
            for authd_test_dir in home cache config data runtime gocache gomodcache cargo; do
                /usr/bin/chown "$AUTHD_TEST_USER_UID:$AUTHD_TEST_USER_GID" "$authd_test_root/$authd_test_dir"
                /usr/bin/chmod 700 "$authd_test_root/$authd_test_dir"
            done

            cat >"$authd_test_bin_dir/go" <<\COPILOT_GO
#!/usr/bin/bash
set -euo pipefail

real_go="${AUTHD_TEST_GO_TOOLCHAIN}/bin/go"
if [[ "${1:-}" != "test" ]]; then
    exec "$real_go" "$@"
fi

case "$PWD" in
    "$AUTHD_TEST_REPO_ROOT")
        cd "$AUTHD_TEST_REPO_ALIAS"
        ;;
    "$AUTHD_TEST_REPO_ROOT"/*)
        repo_subdir="${PWD#"$AUTHD_TEST_REPO_ROOT"}"
        cd "$AUTHD_TEST_REPO_ALIAS$repo_subdir"
        ;;
    "$AUTHD_TEST_REPO_ALIAS"|"$AUTHD_TEST_REPO_ALIAS"/*)
        ;;
    *)
        exec "$real_go" "$@"
        ;;
esac

test_root=/tmp/copilot-authd-test
export HOME="$test_root/home"
export XDG_CACHE_HOME="$test_root/cache"
export XDG_CONFIG_HOME="$test_root/config"
export XDG_DATA_HOME="$test_root/data"
export XDG_RUNTIME_DIR="$test_root/runtime"
export GOCACHE="$test_root/gocache"
export GOMODCACHE="$test_root/gomodcache"
export CARGO_HOME="$test_root/cargo"
export CARGO_NET_OFFLINE=true
if [[ -n "${AUTHD_TEST_RUST_TOOLCHAIN:-}" ]]; then
    unset RUSTUP_HOME RUSTUP_TOOLCHAIN RUSTUP_AUTO_UPDATE RUSTUP_NO_UPDATE_CHECK
else
    export RUSTUP_HOME="$AUTHD_TEST_RUSTUP_HOME"
fi
export GOROOT="$AUTHD_TEST_GO_TOOLCHAIN"
export GOTOOLCHAIN=local
export TMPDIR=/tmp
export RUSTUP_AUTO_UPDATE=0
export RUSTUP_NO_UPDATE_CHECK=1
export USER="$AUTHD_TEST_USER_NAME"
export LOGNAME="$AUTHD_TEST_USER_NAME"
unset DBUS_SESSION_BUS_ADDRESS GH_TOKEN JIRA_API_TOKEN SSH_AUTH_SOCK COPILOT_HOME
GOFLAGS="${GOFLAGS:+$GOFLAGS }-buildvcs=false -p=1"
export GOFLAGS

# Keep peer credentials non-root while retaining only sandbox-scoped capabilities.
test_caps="cap_chown,cap_fowner,cap_fsetid,cap_setgid,cap_setuid,cap_setpcap,cap_net_bind_service,cap_net_admin,cap_sys_chroot,cap_sys_admin,cap_mknod,cap_setfcap"
exec /usr/sbin/capsh \
    --keep=1 \
    --user="$AUTHD_TEST_USER_NAME" \
    --caps="$test_caps+eip" \
    --addamb="$test_caps" \
    --groups=0 \
    --noenv \
    -- -c "exec \"\$@\"" copilot-authd-go-test \
    /usr/bin/dbus-run-session -- "$real_go" test -p=1 "${@:2}"
COPILOT_GO
            /usr/bin/chmod 755 "$authd_test_bin_dir/go"
            export PATH="$authd_test_bin_dir:$PATH"
        fi

        if [[ "${COPILOT_SANDBOX_SHELL:-}" == true ]]; then
            shell_rc_dir="$(mktemp -d /tmp/copilot-runtime/shell-rc.XXXXXXXX)"
            chmod 700 "$shell_rc_dir"
            case "$COPILOT_SANDBOX_SHELL_KIND" in
            bash)
                shell_rcfile="$shell_rc_dir/bashrc"
                ;;
            zsh)
                shell_rcfile="$shell_rc_dir/.zshrc"
                ;;
            *)
                echo "error: unsupported interactive shell: $COPILOT_SANDBOX_SHELL_KIND" >&2
                exit 1
                ;;
            esac
            cat >"$shell_rcfile" <<\COPILOT_RC
cleanup_copilot_services() {
    local pid
    for pid in "${COPILOT_SANDBOX_KEYRING_PID:-}" "${COPILOT_SANDBOX_DBUS_PID:-}"; do
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
        fi
    done
}
trap cleanup_copilot_services EXIT
COPILOT_RC
            chmod 600 "$shell_rcfile"
            export COPILOT_SANDBOX_DBUS_PID="$dbus_pid"
            export COPILOT_SANDBOX_KEYRING_PID="$keyring_pid"
            case "$COPILOT_SANDBOX_SHELL_KIND" in
            bash)
                exec "$COPILOT_SANDBOX_SHELL_PATH" --noprofile --rcfile "$shell_rcfile" -i
                ;;
            zsh)
                export ZDOTDIR="$shell_rc_dir"
                exec "$COPILOT_SANDBOX_SHELL_PATH" -i
                ;;
            esac
        fi

        if "$@"; then
            status=0
        else
            status=$?
        fi
        exit "$status"
    ' -- "$COPILOT_BIN" --allow-all "$@"
then
    bwrap_status=0
else
    bwrap_status=$?
fi

cleanup_authd_test_private_fixtures
exit "$bwrap_status"
