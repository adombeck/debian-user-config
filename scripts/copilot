if [[ "$ALLOW_E2E_TESTS" == true ]]; then
    SANDBOX_ENV_ARGS+=(--setenv AUTHD_E2E_LIBVIRT_SESSION true)
    SANDBOX_ENV_ARGS+=(--setenv LIBVIRT_DEFAULT_URI 'qemu+unix:///session?socket=/var/run/libvirt/libvirt-sock')

    AUTHD_E2E_DNS_SERVER="${AUTHD_E2E_DNS_SERVER:-}"
    E2E_DNS_ROUTE_DEVICE=
    if [[ -z "$AUTHD_E2E_DNS_SERVER" ]] &&
        command -v ip >/dev/null 2>&1 &&
        command -v resolvectl >/dev/null 2>&1; then
        E2E_DNS_ROUTE_DEVICE="$(
            ip -4 -o route get 1.1.1.1 2>/dev/null |
                awk '{for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i + 1); exit}}' ||
                true
        )"
        if [[ -n "$E2E_DNS_ROUTE_DEVICE" ]]; then
            AUTHD_E2E_DNS_SERVER="$(
                resolvectl dns "$E2E_DNS_ROUTE_DEVICE" 2>/dev/null |
                    awk '{for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $i !~ /^127\./) {print $i; exit}}' ||
                    true
            )"
        fi
        if [[ -z "$AUTHD_E2E_DNS_SERVER" ]]; then
            AUTHD_E2E_DNS_SERVER="$(
                resolvectl dns 2>/dev/null |
                    awk '{for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $i !~ /^127\./) {print $i; exit}}' ||
                    true
            )"
        fi
    fi
    if [[ -n "$AUTHD_E2E_DNS_SERVER" ]]; then
        if [[ ! "$AUTHD_E2E_DNS_SERVER" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
            echo "error: AUTHD_E2E_DNS_SERVER must be an IPv4 address" >&2
            exit 1
        fi
        SANDBOX_ENV_ARGS+=(--setenv AUTHD_E2E_DNS_SERVER "$AUTHD_E2E_DNS_SERVER")
    fi
fi

# Expose read-only libvirt metadata by default. The E2E profile gets read-only
