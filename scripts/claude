#!/usr/bin/env bash
#
# Run Claude Code in a bubblewrap sandbox with filesystem access restricted to
# ~/projects (read-write) and a minimal read-only base system. If the cwd is
# outside ~/projects, its Git repository root is bind-mounted when available;
# otherwise the cwd is bind-mounted so Claude can still work there. Network is
# left up, since Claude Code needs to reach
# api.anthropic.com; narrow this further with a network namespace + proxy if
# you want a domain allowlist too.
#
# Installation from the repository root:
#   mv ~/.local/bin/claude ~/.local/bin/claude.real
#   ./scripts/install.sh
#
# The first command preserves the original Claude executable; the installer
# then creates ~/.local/bin/claude as a symlink to this wrapper.
#
# Usage: ./claude [claude args...]

set -euo pipefail

PROJECTS_DIR="${HOME}/projects"
CLAUDE_CONFIG_DIR="${HOME}/.claude"
CLAUDE_JSON="${HOME}/.claude.json"

if [[ ! -d "$PROJECTS_DIR" ]]; then
    echo "error: $PROJECTS_DIR does not exist" >&2
    exit 1
fi

# Resolve real paths so a symlinked cwd still matches under PROJECTS_DIR.
PROJECTS_DIR="$(realpath "$PROJECTS_DIR")"
CWD="$(realpath "$PWD")"
WORKDIR="$CWD"

# Mount the repository root when the cwd is inside a repository so Claude can
# access the repository metadata and the rest of the worktree.
MOUNT_DIR="$CWD"
if REPO_ROOT="$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)"; then
    MOUNT_DIR="$(realpath "$REPO_ROOT")"
fi

# If the mount directory isn't already covered by the PROJECTS_DIR bind mount,
# bind it in separately so Claude can still read/write it.
EXTRA_BIND_ARGS=()
case "$MOUNT_DIR" in
    "$PROJECTS_DIR"|"$PROJECTS_DIR"/*)
        ;;
    *)
        EXTRA_BIND_ARGS=(--bind "$MOUNT_DIR" "$MOUNT_DIR")
        ;;
esac

if ! command -v bwrap >/dev/null 2>&1; then
    echo "error: bubblewrap (bwrap) not found. Install with: sudo apt install bubblewrap" >&2
    exit 1
fi

if ! command -v claude >/dev/null 2>&1; then
    echo "error: claude CLI not found on PATH" >&2
    exit 1
fi

CLAUDE_DIR="$(dirname "$(command -v claude)")"
CLAUDE_BIN="${CLAUDE_DIR}/claude.real"

if [[ ! -x "$CLAUDE_BIN" ]]; then
    echo "error: $CLAUDE_BIN not found or not executable" >&2
    exit 1
fi

# Build bind args for Claude's own config, creating them first if absent so
# bwrap has something to bind (bwrap --bind requires the source to exist).
mkdir -p "$CLAUDE_CONFIG_DIR"
touch "$CLAUDE_JSON"

# Sign commits without interaction using a TPM-bound key served by
# ssh-tpm-agent. Only the agent socket and the public key are exposed; the
# private key never leaves the TPM. The signing config is passed via
# GIT_CONFIG_* env vars so the user's own commits keep their normal signing
# setup. Skipped entirely unless both the socket and the public key exist.
TPM_AGENT_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-tpm-agent.sock"
TPM_SIGNING_PUB="${HOME}/.ssh/id_ecdsa_claude_signing.pub"
TPM_ALLOWED_SIGNERS="${HOME}/.config/git/allowed_signers"
SIGNING_ARGS=()
if [[ -S "$TPM_AGENT_SOCK" && -f "$TPM_SIGNING_PUB" ]]; then
    SIGNING_ARGS=(
        --bind "$TPM_AGENT_SOCK" "$TPM_AGENT_SOCK"
        --setenv SSH_AUTH_SOCK "$TPM_AGENT_SOCK"
        --setenv GIT_CONFIG_COUNT 4
        --setenv GIT_CONFIG_KEY_0 gpg.format
        --setenv GIT_CONFIG_VALUE_0 ssh
        --setenv GIT_CONFIG_KEY_1 user.signingkey
        --setenv GIT_CONFIG_VALUE_1 "$TPM_SIGNING_PUB"
        --setenv GIT_CONFIG_KEY_2 commit.gpgsign
        --setenv GIT_CONFIG_VALUE_2 true
        --setenv GIT_CONFIG_KEY_3 gpg.ssh.allowedSignersFile
        --setenv GIT_CONFIG_VALUE_3 "$TPM_ALLOWED_SIGNERS"
    )
    [[ -f "$TPM_ALLOWED_SIGNERS" ]] &&
        SIGNING_ARGS+=(--ro-bind "$TPM_ALLOWED_SIGNERS" "$TPM_ALLOWED_SIGNERS")
fi

exec bwrap \
    --unshare-all \
    --share-net \
    --die-with-parent \
    --new-session \
    \
    --ro-bind /usr /usr \
    --ro-bind /bin /bin \
    --ro-bind /lib /lib \
    --ro-bind-try /lib64 /lib64 \
    --ro-bind-try /snap /snap \
    --ro-bind-try "${HOME}/.local/bin" "${HOME}/.local/bin" \
    --ro-bind-try "${HOME}/go/bin" "${HOME}/go/bin" \
    --ro-bind-try "${HOME}/.gitconfig" "${HOME}/.gitconfig" \
    --ro-bind-try "${HOME}/.ssh" "${HOME}/.ssh" \
    --ro-bind-try /etc/alternatives /etc/alternatives \
    --ro-bind /etc/resolv.conf /etc/resolv.conf \
    --ro-bind /etc/ssl /etc/ssl \
    --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf \
    --ro-bind /etc/hosts /etc/hosts \
    --ro-bind /etc/passwd /etc/passwd \
    --ro-bind /etc/group /etc/group \
    --ro-bind "$CLAUDE_BIN" "$CLAUDE_BIN" \
    \
    --dev /dev \
    --proc /proc \
    --tmpfs /tmp \
    \
    --bind "$PROJECTS_DIR" "$PROJECTS_DIR" \
    "${EXTRA_BIND_ARGS[@]}" \
    --bind "$CLAUDE_CONFIG_DIR" "$CLAUDE_CONFIG_DIR" \
    --bind "$CLAUDE_JSON" "$CLAUDE_JSON" \
    "${SIGNING_ARGS[@]}" \
    \
    --setenv HOME "$HOME" \
    --setenv CLAUDE_CONFIG_DIR "$CLAUDE_CONFIG_DIR" \
    --setenv PATH "$PATH" \
    \
    --chdir "$WORKDIR" \
    "$CLAUDE_BIN" "$@"
